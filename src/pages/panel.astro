---
/**
 * Página /panel: tu pantalla de personaje con progreso REAL (Supabase). Es
 * privada: el middleware manda a /entrar a quien llegue sin sesión.
 *
 * Es de servidor (`prerender = false`): «hoy» se calcula en cada visita, en la zona
 * horaria del plan, y el día del plan sale de TU `fecha_inicio` (perfil), no del build.
 *
 * Esta página solo carga los datos; lo que se ve está en `PantallaPanel`.
 */
import Base from "@/layouts/Base.astro";
import PantallaPanel from "@/components/cuenta/PantallaPanel.astro";
import { SITIO } from "@/config/sitio";
import { cargarContenido } from "@/lib/contenido";
import { cargarProgresoUsuario } from "@/lib/progreso-usuario";
import { diaDelPlan, hoyIso, parsearFecha } from "@/lib/fechas";

export const prerender = false;

const { supabase, usuario } = Astro.locals;
const c = await cargarContenido();
const { perfil, progreso, diasCompletados } = await cargarProgresoUsuario(supabase);

const fechaHoy = hoyIso(SITIO.zonaHoraria);
const hoy = diaDelPlan(parsearFecha(fechaHoy), perfil.fecha_inicio);
const nombre = perfil.nombre ?? usuario?.email?.split("@")[0] ?? "flautista";
---

<Base titulo="Panel" descripcion="Tu sesión de hoy, tu racha y dónde vas en el camino." ancho="completo">
  <PantallaPanel c={c} progreso={progreso} diasCompletados={diasCompletados} hoy={hoy} fechaHoy={fechaHoy} nombre={nombre} email={usuario?.email ?? undefined} />
</Base>
