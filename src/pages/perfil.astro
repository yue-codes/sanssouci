---
/**
 * Página /perfil: tu nombre y las fechas que mueven el plan (día 1 y llegada de la
 * flauta). Es privada (`RUTAS_PRIVADAS`: sin sesión, el middleware manda a /entrar)
 * y de servidor (`prerender = false`):
 * - GET: muestra el formulario con lo guardado.
 * - POST: valida (`validarPerfil`), guarda en `perfiles` y redirige a `/perfil?guardado=1`.
 *
 * Tras guardar se redirige (patrón POST → redirección → GET): así, recargar la página
 * no vuelve a mandar el formulario, y la confirmación sale una sola vez.
 * Aquí está la lógica; lo que se ve está en `TarjetaPerfil`.
 */
import { Flame, KeyRound, LogOut, Sprout, TriangleAlert } from "lucide-preact";
import Base from "@/layouts/Base.astro";
import PantallaCuenta from "@/components/cuenta/PantallaCuenta.astro";
import TarjetaPerfil from "@/components/cuenta/TarjetaPerfil.astro";
import { IMAGENES } from "@/config/imagenes";
import { SITIO } from "@/config/sitio";
import { cargarContenido } from "@/lib/contenido";
import { diaDelPlan, fechaLarga, hoyIso, parsearFecha } from "@/lib/fechas";
import { validarPerfil, valoresDeFormulario, type ValoresPerfil } from "@/lib/perfil";

export const prerender = false;

const { supabase, usuario } = Astro.locals;
// El middleware ya garantiza la sesión en esta ruta; esto es para TypeScript.
if (!usuario) return Astro.redirect("/entrar?siguiente=%2Fperfil");

const { data: perfil, error: errorLectura } = await supabase.from("perfiles").select("nombre, fecha_inicio, fecha_llegada_flauta").single();
if (errorLectura) throw new Error(`No se pudo leer el perfil: ${errorLectura.message}`);

let valores: ValoresPerfil = {
  nombre: perfil.nombre ?? "",
  fechaInicio: perfil.fecha_inicio,
  fechaFlauta: perfil.fecha_llegada_flauta ?? "",
};
let errores: Partial<Record<keyof ValoresPerfil, string>> = {};
let errorGeneral: string | undefined;

if (Astro.request.method === "POST") {
  valores = valoresDeFormulario(await Astro.request.formData());
  const r = validarPerfil(valores);
  if (!r.ok) errores = r.errores;
  else {
    // `.eq("id", …)`: Supabase pide un filtro en cada update (para no tocar toda la tabla
    // por error). RLS ya impide tocar otro perfil, pero el filtro deja clara la intención.
    const { error } = await supabase.from("perfiles").update(r.datos).eq("id", usuario.id);
    if (!error) return Astro.redirect("/perfil?guardado=1", 303);
    console.error("[perfil] Supabase:", error.message);
    errorGeneral = "No se pudo guardar. Inténtalo de nuevo en un momento.";
  }
}

const guardado = Astro.request.method === "GET" && Astro.url.searchParams.get("guardado") === "1";

// Lo que significan tus fechas guardadas, para verlo antes de cambiarlas.
const fechaHoy = hoyIso(SITIO.zonaHoraria);
const hoy = diaDelPlan(parsearFecha(fechaHoy), perfil.fecha_inicio);
// Las páginas públicas (portada, mapa, calendario) cuentan los días desde el día 1 de
// dias.json; el panel, desde tu perfil. Si no coinciden, cada sitio diría un día distinto.
const inicioPlan = [...(await cargarContenido()).dias].sort((a, b) => a.data.numero - b.data.numero)[0].data.fecha;
const desfase = perfil.fecha_inicio !== inicioPlan;
const enPlan = hoy < 1 ? `Empiezas el ${fechaLarga(perfil.fecha_inicio)}` : hoy > 90 ? "Ya completaste los 90 días" : `Hoy es el día ${hoy} de 90`;
---

<Base titulo="Perfil" descripcion="Tu nombre y las fechas de tu plan." ancho="completo">
  <PantallaCuenta imagen={IMAGENES.flautaCerezos} titulo="titulo-perfil">
    <!-- ============ Lo que significan tus fechas ============ -->
    <p class="eyebrow">Sanssouci · ajustes de partida</p>
    <h1 id="titulo-perfil" class="mt-4 text-6xl leading-[0.92] sm:text-8xl">
      Tu <em class="text-acento">partida</em>.
    </h1>
    <p class="mt-5 max-w-[46ch] text-lg text-tenue">
      Tus fechas mueven el calendario: el día 1 dice en qué misión vas, y la llegada de la flauta marca el paso a las semanas con flauta.
    </p>
    <ul class="mt-10 grid gap-4">
      <li class="flex items-center gap-4">
        <span class="grid size-10 shrink-0 place-items-center rounded-full border border-acento/50 text-acento" aria-hidden="true"><Flame size={17} /></span>
        <span><strong class="font-medium">{enPlan}</strong> <span class="text-tenue">· día 1: {fechaLarga(perfil.fecha_inicio)}</span></span>
      </li>
      <li class="flex items-center gap-4">
        <span class="grid size-10 shrink-0 place-items-center rounded-full border border-resalte/50 text-resalte" aria-hidden="true"><Sprout size={17} /></span>
        <span>
          {perfil.fecha_llegada_flauta
            ? <><strong class="font-medium">La flauta llegó</strong> <span class="text-tenue">el {fechaLarga(perfil.fecha_llegada_flauta)}</span></>
            : <><strong class="font-medium">La flauta aún no llega</strong> <span class="text-tenue">· anótala aquí el día que la tengas</span></>}
        </span>
      </li>
    </ul>
    {desfase && (
      <p role="alert" class="mt-6 flex max-w-[46ch] items-start gap-2.5 rounded-md border border-resalte/40 bg-resalte/10 px-4 py-3 text-sm">
        <TriangleAlert size={16} class="mt-0.5 shrink-0 text-resalte" aria-hidden="true" />
        <span>Tu día 1 no coincide con el del plan (<strong class="font-medium">{fechaLarga(inicioPlan)}</strong>): el panel y el calendario contarían días distintos. Pon esa fecha en «Día 1 del plan».</span>
      </p>
    )}

    <!-- ============ Tarjeta: el formulario ============ -->
    <div slot="tarjeta">
      <TarjetaPerfil valores={valores} errores={errores} errorGeneral={errorGeneral} guardado={guardado} email={usuario.email ?? undefined} />
      <!-- Cerrar sesión es un formulario POST, no un enlace: un GET lo puede pedir el navegador
           solo (al precargar) u otra web, y te sacaría sin querer. -->
      <div class="mt-4 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm">
        <a href="/contrasena" class="inline-flex items-center gap-1.5 text-acento hover:text-acento-claro"><KeyRound size={14} aria-hidden="true" /> Cambiar contraseña</a>
        <form method="post" action="/auth/salir">
          <button type="submit" class="inline-flex items-center gap-1.5 text-tenue transition-colors hover:text-texto">
            <LogOut size={14} aria-hidden="true" /> Cerrar sesión
          </button>
        </form>
        <a href="/panel" class="enlace-flecha">Volver al panel <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </PantallaCuenta>
</Base>
