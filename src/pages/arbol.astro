---
/**
 * Página /arbol: árbol de talentos estilo RPG.
 * Datos: `construirNodosArbol` (src/lib/arbol.ts). Progreso: de ejemplo hasta la fase 4.
 */
import "@fontsource-variable/pixelify-sans";
import Base from "@/layouts/Base.astro";
import Aviso from "@/components/ui/Aviso.astro";
import ArbolTalentos from "@/components/logros/arbol/ArbolTalentos";
import { ORDEN_RAMAS } from "@/components/logros/categorias";
import { cargarContenido } from "@/lib/contenido";
import { construirNodosArbol } from "@/lib/arbol";
import { PROGRESO_EJEMPLO } from "@/lib/ejemplo";

const c = await cargarContenido();
const nodos = construirNodosArbol(c, ORDEN_RAMAS);
---

<Base titulo="Árbol de talentos" descripcion="Las habilidades del temario como un árbol: qué tienes, qué puedes conseguir ya y qué abre cada una.">
  <Aviso class="mb-6">
    El progreso es de ejemplo hasta que exista el inicio de sesión. Puedes marcar talentos para probar cómo se desbloquean los siguientes; no se guarda.
  </Aviso>

  <header class="max-w-3xl">
    <p class="eyebrow">Árbol de talentos</p>
    <h1 class="mt-3 font-pixel text-4xl leading-tight font-semibold sm:text-6xl">Tus habilidades</h1>
    <p class="mt-4 text-lg leading-relaxed text-tenue">
      Cada rama es una parte del temario y cada línea, un requisito.
      Lo <span class="font-semibold text-resalte">disponible</span> lo puedes conseguir ya;
      lo <span class="font-semibold text-acento">conseguido</span> ya es tuyo.
    </p>
  </header>

  <div class="mt-8">
    <ArbolTalentos client:load nodos={nodos} ramas={ORDEN_RAMAS} obtenidos={[...PROGRESO_EJEMPLO.obtenidos]} />
  </div>
</Base>
