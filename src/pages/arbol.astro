---
/**
 * Página /arbol: árbol de talentos estilo RPG, como un mapa de estrellas.
 * Arriba, una portada con la imagen; debajo, la isla `ArbolTalentos` (marcador,
 * lienzo y ficha). Datos: `construirNodosArbol` (src/lib/arbol.ts).
 * Progreso: de ejemplo hasta la fase 4.
 */
import "@fontsource-variable/pixelify-sans";
import FondoPortada from "@/components/ui/FondoPortada.astro";
import Base from "@/layouts/Base.astro";
import ArbolTalentos from "@/components/logros/arbol/ArbolTalentos";
import { ORDEN_RAMAS } from "@/components/logros/categorias";
import { cargarContenido } from "@/lib/contenido";
import { construirNodosArbol } from "@/lib/arbol";
import { PROGRESO_EJEMPLO } from "@/lib/ejemplo";
import { IMAGENES } from "@/config/imagenes";

const c = await cargarContenido();
const nodos = construirNodosArbol(c, ORDEN_RAMAS);
const imagen = IMAGENES.animeLago;
---

<Base
  titulo="Árbol de talentos"
  descripcion="Las habilidades del temario como un árbol de talentos: qué tienes, qué puedes conseguir ya y qué abre cada una."
  ancho="completo"
>
  <section class="relative isolate overflow-hidden border-b border-borde" aria-labelledby="titulo-arbol">
    <FondoPortada imagen={imagen} velo={0.5} lateral={0.2} />
    <span class="absolute inset-0 -z-10 bg-fondo/50 sm:hidden" aria-hidden="true"></span>

    <div class="contenedor py-14 sm:py-20" data-revelar="hijos">
      <p class="eyebrow">Árbol de talentos · {ORDEN_RAMAS.length} ramas · {nodos.length} talentos</p>
      <h1 id="titulo-arbol" class="mt-4 font-pixel text-5xl leading-none sm:text-7xl">Tus habilidades</h1>
      <p class="mt-5 max-w-[52ch] text-lg text-tenue">
        Cada rama es una parte del temario y cada línea, un requisito.
        Lo <span class="text-resalte">disponible</span> lo puedes conseguir ya;
        lo <span class="text-exito">conseguido</span> ya es tuyo. Elige un talento para ver su ruta.
      </p>
      <p class="mt-6 font-mono text-[0.625rem] text-tenue uppercase">
        Progreso de ejemplo · puedes desbloquear talentos para probar, no se guarda ·
        <a href="/entrar" class="text-acento underline-offset-4 hover:underline">entra</a> para llevar el tuyo
      </p>
    </div>
  </section>

  <div class="mx-auto w-full max-w-[90rem] px-4 py-10 sm:px-8 sm:py-14">
    <ArbolTalentos client:load nodos={nodos} ramas={ORDEN_RAMAS} obtenidos={[...PROGRESO_EJEMPLO.obtenidos]} />
  </div>
</Base>
