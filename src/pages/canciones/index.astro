---
/**
 * Página /canciones: el repertorio como un mazo de cartas. Portada con el mazo
 * (obras, retos de oído, de jefe) y la leyenda de rarezas; debajo, el catálogo con
 * filtros. La portada es estática; el catálogo es una Server Island
 * (`CatalogoConProgreso`, `server:defer`) con tu progreso: cartas bloqueadas y tu
 * avance con cada una. Acepta filtros en la URL, p. ej. /canciones?zona=nivel-3&oido=1,
 * /canciones?listas=1 o /canciones?estado=aprendiendo.
 */
import FondoPortada from "@/components/ui/FondoPortada.astro";
import Base from "@/layouts/Base.astro";
import CatalogoConProgreso from "@/components/canciones/catalogo/CatalogoConProgreso.astro";
import { RAREZAS } from "@/components/canciones/rareza";
import { cargarContenido, esRetoDeOido } from "@/lib/contenido";
import { IMAGENES } from "@/config/imagenes";

const c = await cargarContenido();
const canciones = c.canciones;
const imagen = IMAGENES.animeAula;
const deJefe = new Set(c.jefes.map((j) => j.data.cancion.id));

// Solo cifras del mazo (iguales para todos): esta portada es estática. Lo que
// depende de tu progreso («puedes tocar ya») está en el catálogo, que es de servidor.
const estadisticas: { valor: number; texto: string; href?: string }[] = [
  { valor: canciones.length, texto: "obras" },
  { valor: canciones.filter(esRetoDeOido).length, texto: "retos de oído", href: "/canciones?oido=1" },
  { valor: canciones.filter((s) => deJefe.has(s.id)).length, texto: "de jefe" },
];
// Cuántas cartas hay de cada rareza (el tramo empieza donde acaba el anterior).
const porRareza = RAREZAS.map((r, i) => ({
  ...r,
  desde: i === 0 ? 1 : RAREZAS[i - 1].hasta + 1,
  n: canciones.filter((s) => s.data.dificultad <= r.hasta && (i === 0 || s.data.dificultad > RAREZAS[i - 1].hasta)).length,
}));
---

<Base titulo="Canciones" descripcion="El repertorio: las obras para flauta traversa, por ruta, zona y dificultad." ancho="completo">
  <!-- ============ PORTADA ============ -->
  <section class="relative isolate overflow-hidden border-b border-borde" aria-labelledby="titulo-canciones">
    <FondoPortada imagen={imagen} />

    <div class="contenedor grid gap-10 py-14 sm:py-20 lg:grid-cols-[1.3fr_1fr] lg:items-end lg:gap-16">
      <div data-revelar="hijos">
        <p class="eyebrow">El repertorio · {c.rutas.length} rutas</p>
        <h1 id="titulo-canciones" class="mt-4 text-6xl leading-[0.92] sm:text-8xl">Canciones</h1>
        <p class="mt-5 max-w-[50ch] text-lg text-tenue">
          Cada obra es una carta: se desbloquea cuando tienes los talentos que pide. Las que no
          tienen partitura son <span class="text-resalte">retos de oído</span>: se sacan con la guitarra.
        </p>
        <dl class="mt-8 flex flex-wrap gap-x-10 gap-y-4">
          {estadisticas.map((e) => (
            <div class="flex flex-col-reverse">
              <dt class="mt-1 font-mono text-[0.625rem] tracking-[0.06em] text-tenue uppercase">
                {e.href ? <a href={e.href} class="underline-offset-2 hover:text-acento hover:underline">{e.texto}</a> : e.texto}
              </dt>
              <dd class="font-display text-5xl leading-none tabular-nums">{e.valor}</dd>
            </div>
          ))}
        </dl>
      </div>

      <!-- Leyenda de rarezas -->
      <section aria-labelledby="titulo-rarezas" data-revelar>
        <h2 id="titulo-rarezas" class="mb-3 font-mono text-[0.625rem] tracking-[0.08em] text-tenue uppercase">Rareza, según la dificultad</h2>
        <ul class="grid grid-cols-2 gap-px overflow-hidden rounded-md border border-borde bg-borde">
          {porRareza.map((r) => (
            <li class="bg-fondo/85 p-4 backdrop-blur-md">
              <span class:list={["flex items-center gap-2 font-mono text-[0.625rem] tracking-[0.08em] uppercase", r.texto]}>
                <span class:list={["size-2 rotate-45", r.fondo]} aria-hidden="true"></span>{r.nombre}
              </span>
              <span class="mt-2 flex items-baseline justify-between gap-2">
                <span class="font-display text-4xl leading-none tabular-nums">{r.n}</span>
                <span class="font-mono text-[0.625rem] text-tenue">dificultad {r.desde === r.hasta ? r.desde : `${r.desde}–${r.hasta}`}</span>
              </span>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </section>

  <div class="contenedor py-14 sm:py-20">
    <CatalogoConProgreso server:defer>
      <!-- Mientras llega del servidor: un esqueleto con la forma del catálogo. -->
      <div slot="fallback" class="grid gap-6 lg:grid-cols-[17rem_minmax(0,1fr)]" aria-busy="true">
        <p class="sr-only">Cargando el catálogo…</p>
        <div class="h-96 animate-pulse rounded-md border border-borde bg-superficie" aria-hidden="true"></div>
        <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3" aria-hidden="true">
          {Array.from({ length: 6 }, () => <div class="h-72 animate-pulse rounded-md border border-borde bg-superficie"></div>)}
        </div>
      </div>
    </CatalogoConProgreso>
  </div>
</Base>
