---
/**
 * Página /canciones: el catálogo completo con filtros (isla `CatalogoCanciones`).
 * Datos: `resumirCancion` (src/lib/canciones.ts). Acepta filtros en la URL,
 * p. ej. /canciones?zona=nivel-3&oido=1.
 */
import Base from "@/layouts/Base.astro";
import CatalogoCanciones from "@/components/canciones/catalogo/CatalogoCanciones";
import { cargarContenido, nombreCortoRuta } from "@/lib/contenido";
import { resumirCancion } from "@/lib/canciones";

const c = await cargarContenido();
const canciones = c.canciones.map((s) => resumirCancion(c, s));
const rutas = c.rutas.map((r) => ({ id: r.id, nombre: nombreCortoRuta(r), color: r.data.color }));
const zonas = c.niveles.map((n) => ({ id: n.id, orden: n.data.orden, nombre: n.data.nombre }));
const retos = canciones.filter((s) => s.retoDeOido).length;
---

<Base titulo="Canciones" descripcion="El catálogo de obras para flauta traversa, por ruta, zona y dificultad.">
  <header class="max-w-3xl">
    <p class="eyebrow">Catálogo · {canciones.length} obras · {retos} retos de oído</p>
    <h1 class="mt-3 text-4xl font-semibold leading-tight sm:text-6xl">Canciones</h1>
    <p class="mt-4 text-lg leading-relaxed text-tenue">
      Cada obra está en la zona donde ya tienes lo que exige. Las que no tienen partitura son
      <span class="font-semibold text-resalte">retos de oído</span>: se sacan con la guitarra.
    </p>
  </header>

  <div class="mt-8">
    <CatalogoCanciones client:load canciones={canciones} rutas={rutas} zonas={zonas} />
  </div>
</Base>
