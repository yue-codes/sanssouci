---
/**
 * Página de muestra de la dirección visual (fase 3).
 * Usa los datos reales de src/data; el progreso (zonas superadas, logros obtenidos)
 * es de EJEMPLO hasta que exista el login (fase 4).
 */
import Base from "@/layouts/Base.astro";
import Aviso from "@/components/ui/Aviso.astro";
import SesionDelDia from "@/components/sesion/SesionDelDia";
import TarjetaZona from "@/components/mapa/TarjetaZona.astro";
import TarjetaJefe from "@/components/jefes/TarjetaJefe.astro";
import TarjetaCancion from "@/components/canciones/TarjetaCancion";
import { resumirCancion } from "@/lib/canciones";
import InsigniaLogro from "@/components/logros/InsigniaLogro.astro";
import { cargarContenido } from "@/lib/contenido";
import { diaDelPlan, fechaLarga } from "@/lib/fechas";
import { Flame, CalendarDays, Swords, Library } from "lucide-preact";

const c = await cargarContenido();
const dias = [...c.dias].sort((a, b) => a.data.numero - b.data.numero);

// La página se genera al compilar, así que "hoy" es la fecha del build.
const hoy = diaDelPlan(new Date(), dias[0].data.fecha);
const antesDeEmpezar = hoy < 1;
const diaMostrado = dias.find((d) => d.data.numero >= Math.max(1, hoy) && d.data.tipo !== "descanso") ?? dias[0];

const jefe0 = c.jefePorId.get("jefe-0")!;
const diaJefe0 = dias.find((d) => d.data.jefe?.id === "jefe-0")!;

const destacadas = ["always-with-me", "wellerman", "enter-hallownest", "merry-go-round-of-life", "la-llorona", "isabellas-lullaby"]
  .map((id) => c.cancionPorId.get(id)!);
const logrosZona0 = c.logros.filter((l) => l.data.nivelSugerido.id === "nivel-0").slice(0, 6);
const OBTENIDOS_EJEMPLO = new Set(["logro-test-lectura", "logro-cuaderno"]);

const estadisticas = [
  { Icono: Flame, valor: "0", etiqueta: "días de racha" },
  { Icono: CalendarDays, valor: `${dias.filter((d) => d.data.tipo !== "descanso").length}`, etiqueta: "sesiones en el plan" },
  { Icono: Swords, valor: `${dias.filter((d) => d.data.jefe).length}`, etiqueta: "jefes en 90 días" },
  { Icono: Library, valor: `${c.canciones.length}`, etiqueta: "obras en tu catálogo" },
];
const paleta = ["fondo", "superficie", "superficie-2", "borde", "tenue", "texto", "acento", "acento-suave", "secundario", "resalte", "exito", "peligro"];
---

<Base titulo="Muestra de diseño">
  <Aviso class="mb-8">Página de muestra de la dirección visual. Las páginas reales: <a href="/mapa" class="font-semibold text-acento hover:underline">/mapa</a> y <a href="/arbol" class="font-semibold text-acento hover:underline">/arbol</a>.</Aviso>

  <!-- ============ HERO ============ -->
  <section class="relative">
    <p class="eyebrow">{antesDeEmpezar ? "Cuenta atrás" : `Semana ${diaMostrado.data.semana} · ${diaMostrado.data.fase === "sin-flauta" ? "sin flauta" : "con flauta"}`}</p>
    <h1 class="mt-3 max-w-3xl text-5xl font-semibold leading-[1.05] tracking-tight sm:text-7xl">
      {antesDeEmpezar ? (
        <>Tu camino empieza <em class="font-normal text-acento">{hoy === 0 ? "mañana" : `en ${1 - hoy} días`}</em>.</>
      ) : (
        <>Día <em class="font-normal text-acento">{hoy}</em> de 90.</>
      )}
    </h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-tenue">
      De la Pradera del Silencio a la Cumbre de Paganini: nueve zonas, diez jefes y un temario serio debajo del juego.
    </p>

    <dl class="mt-10 grid grid-cols-2 gap-3 lg:grid-cols-4">
      {estadisticas.map(({ Icono, valor, etiqueta }) => (
        <div class="tarjeta flex items-center gap-4 p-4">
          <span class="grid size-11 place-items-center rounded-xl bg-superficie-2 text-acento"><Icono size={20} aria-hidden="true" /></span>
          <div>
            <dd class="font-display text-3xl font-semibold leading-none">{valor}</dd>
            <dt class="mt-1 text-xs text-tenue">{etiqueta}</dt>
          </div>
        </div>
      ))}
    </dl>

    <!-- Línea de 90 días: cada celda es un día -->
    <div class="tarjeta mt-4 p-5">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h2 class="text-lg font-semibold">Los 90 días</h2>
        <p class="text-xs text-tenue">2 nov 2026 → 30 ene 2027</p>
      </div>
      <ol class="mt-4 grid grid-cols-[repeat(15,minmax(0,1fr))] gap-1 sm:grid-cols-[repeat(30,minmax(0,1fr))]" aria-label="Calendario de 90 días">
        {dias.map((d) => {
          const t = d.data;
          const clase = t.jefe
            ? "bg-acento rotate-45 scale-75 rounded-[3px]"
            : t.tipo === "descanso"
              ? "bg-borde/50"
              : t.fase === "sin-flauta" ? "bg-resalte/45" : "bg-secundario/50";
          return (
            <li title={`Día ${t.numero} · ${t.titulo}`} class={`aspect-square rounded-[4px] ${clase} ${t.numero === hoy ? "ring-2 ring-texto ring-offset-2 ring-offset-superficie" : ""}`}>
              <span class="sr-only">Día {t.numero}: {t.titulo}</span>
            </li>
          );
        })}
      </ol>
      <ul class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-xs text-tenue">
        <li class="flex items-center gap-2"><span class="size-3 rounded-[3px] bg-resalte/45"></span> Sin flauta</li>
        <li class="flex items-center gap-2"><span class="size-3 rounded-[3px] bg-secundario/50"></span> Con flauta</li>
        <li class="flex items-center gap-2"><span class="size-3 rounded-[3px] bg-borde/50"></span> Descanso</li>
        <li class="flex items-center gap-2"><span class="size-2.5 rotate-45 rounded-[2px] bg-acento"></span> Jefe</li>
      </ul>
    </div>
  </section>

  <!-- ============ SESIÓN ============ -->
  <section class="mt-16">
    <p class="eyebrow">{antesDeEmpezar ? "Tu primera sesión" : "Sesión de hoy"} · {fechaLarga(diaMostrado.data.fecha)}</p>
    <div class="tarjeta mt-3 p-6 sm:p-8">
      <h2 class="text-3xl font-semibold">{diaMostrado.data.titulo}</h2>
      <p class="mt-2 text-tenue">{diaMostrado.data.objetivo}</p>
      <div class="mt-6">
        <SesionDelDia client:visible bloques={diaMostrado.data.bloques} />
      </div>
      {diaMostrado.data.notas && <p class="mt-6 rounded-xl bg-superficie-2/70 p-4 text-sm leading-relaxed">💡 {diaMostrado.data.notas}</p>}
    </div>
  </section>

  <!-- ============ MAPA ============ -->
  <section class="mt-16">
    <div class="flex items-end justify-between gap-4">
      <div>
        <p class="eyebrow">El mapa</p>
        <h2 class="mt-2 text-3xl font-semibold">Nueve zonas hasta la cumbre</h2>
      </div>
      <a href="/mapa" class="shrink-0 text-sm font-medium text-acento hover:underline">Ver mapa completo →</a>
    </div>
    <div class="relative mt-6">
      <div class="pointer-events-none absolute top-1/2 right-0 left-0 h-px bg-gradient-to-r from-acento via-borde to-transparent" aria-hidden="true"></div>
      <div class="relative -mx-4 flex snap-x gap-4 overflow-x-auto px-4 pb-4 [scrollbar-width:thin]">
        {c.niveles.map((n) => <TarjetaZona nivel={n} estado={n.data.orden === 0 ? "actual" : "bloqueada"} progreso={0.08} />)}
      </div>
    </div>
  </section>

  <!-- ============ JEFE ============ -->
  <section class="mt-16">
    <TarjetaJefe jefe={jefe0} cancion={c.cancionPorId.get(jefe0.data.cancion.id)!} diasRestantes={Math.max(0, diaJefe0.data.numero - Math.max(hoy, 0))} />
  </section>

  <!-- ============ LOGROS + CANCIONES ============ -->
  <section class="mt-16 grid gap-10 lg:grid-cols-[1fr_1.6fr]">
    <div>
      <p class="eyebrow">Logros · Zona 0</p>
      <h2 class="mt-2 text-3xl font-semibold">Tus primeras insignias</h2>
      <div class="mt-6 grid gap-3">
        {logrosZona0.map((l) => <InsigniaLogro logro={l} obtenido={OBTENIDOS_EJEMPLO.has(l.id)} />)}
      </div>
    </div>
    <div>
      <p class="eyebrow">Repertorio</p>
      <h2 class="mt-2 text-3xl font-semibold">Canciones de tus primeras zonas</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {destacadas.map((s) => <TarjetaCancion cancion={resumirCancion(c, s)} />)}
      </div>
    </div>
  </section>

  <!-- ============ PALETA ============ -->
  <section class="mt-16">
    <p class="eyebrow">Sistema de diseño</p>
    <h2 class="mt-2 text-3xl font-semibold">Paleta y tipografía</h2>
    <div class="mt-6 grid grid-cols-3 gap-3 sm:grid-cols-6 lg:grid-cols-11">
      {paleta.map((p) => (
        <div class="tarjeta overflow-hidden">
          <div class="h-14 border-b border-borde" style={`background: var(--${p})`}></div>
          <p class="px-2 py-1.5 text-[11px] text-tenue">{p}</p>
        </div>
      ))}
    </div>
    <div class="tarjeta mt-4 grid gap-6 p-6 sm:grid-cols-2">
      <div>
        <p class="text-xs text-tenue">Títulos · Fraunces</p>
        <p class="mt-2 font-display text-4xl">Siempre conmigo</p>
      </div>
      <div>
        <p class="text-xs text-tenue">Texto · Inter</p>
        <p class="mt-2 leading-relaxed">Notas largas de 6 s de Re4 a Do5 sin que el sonido se rompa.</p>
      </div>
    </div>
  </section>
</Base>
