---
/**
 * Página /niveles/[id]: detalle de una zona del mapa.
 * Estado, requisitos para pasar, temario, jefe(s), canciones y logros de la zona.
 *
 * `getStaticPaths` le dice a Astro qué páginas generar al compilar: una por zona.
 * Si mañana se añade una zona en niveles.json, su página aparece sola.
 */
import { getCollection } from "astro:content";
import { Check, Footprints, Lock } from "lucide-preact";
import Base from "@/layouts/Base.astro";
import Aviso from "@/components/ui/Aviso.astro";
import MigasDePan from "@/components/ui/MigasDePan.astro";
import EncabezadoSeccion from "@/components/ui/EncabezadoSeccion.astro";
import NavegacionVecinos from "@/components/ui/NavegacionVecinos.astro";
import ChipLogro from "@/components/logros/ChipLogro.astro";
import TemarioZona from "@/components/niveles/TemarioZona.astro";
import TarjetaJefe from "@/components/jefes/TarjetaJefe.astro";
import TarjetaCancion from "@/components/canciones/TarjetaCancion.astro";
import { cargarContenido } from "@/lib/contenido";
import { construirSendero } from "@/lib/mapa";
import { logrosConEstado } from "@/lib/logros";
import { PROGRESO_EJEMPLO } from "@/lib/ejemplo";

export async function getStaticPaths() {
  const niveles = await getCollection("niveles");
  return niveles.map((n) => ({ params: { id: n.id } }));
}

const { id } = Astro.params;
const c = await cargarContenido();
const paradas = construirSendero(c, PROGRESO_EJEMPLO);
const i = paradas.findIndex((p) => p.nivel.id === id);
const parada = paradas[i];
const n = parada.nivel.data;

const canciones = c.canciones
  .filter((s) => s.data.nivel.id === id)
  .sort((a, b) => a.data.dificultad - b.data.dificultad || a.data.titulo.localeCompare(b.data.titulo));

// Logros sugeridos para esta zona que no son requisito para pasar.
const idsRequisitos = new Set(parada.requisitos.map((r) => r.logro.id));
const otrosLogros = logrosConEstado(
  c,
  c.logros.filter((l) => l.data.nivelSugerido.id === id && !idsRequisitos.has(l.id)).map((l) => l.id),
  PROGRESO_EJEMPLO.obtenidos,
);

const ESTADO = {
  superada: { texto: "Superada", Icono: Check, clase: "bg-exito text-fondo" },
  actual: { texto: "Estás aquí", Icono: Footprints, clase: "bg-acento text-fondo" },
  bloqueada: { texto: "Bloqueada", Icono: Lock, clase: "bg-superficie-2 text-tenue" },
}[parada.estado];

const vecino = (p?: (typeof paradas)[number]) =>
  p && { href: `/niveles/${p.nivel.id}`, etiqueta: `Zona ${p.nivel.data.orden}`, titulo: p.nivel.data.nombre };
---

<Base titulo={`Zona ${n.orden}: ${n.nombre}`} descripcion={n.resumen}>
  <MigasDePan items={[{ texto: "Mapa", href: "/mapa" }, { texto: `Zona ${n.orden}` }]} />

  <!-- ============ CABECERA ============ -->
  <header class="max-w-3xl">
    <p class="eyebrow">Zona {n.orden} · {n.zona}</p>
    <h1 class="mt-3 text-4xl font-semibold leading-tight sm:text-6xl">{n.nombre}</h1>
    <p class="mt-4 text-lg leading-relaxed text-tenue">{n.resumen}</p>
    <div class="mt-5 flex flex-wrap items-center gap-3 text-sm">
      <span class:list={["inline-flex items-center gap-1.5 rounded-full px-3 py-1 font-semibold", ESTADO.clase]}>
        <ESTADO.Icono size={14} aria-hidden="true" /> {ESTADO.texto}
      </span>
      <span class="text-tenue">Estimación: {n.estimacion}</span>
    </div>
  </header>

  <Aviso class="mt-6">El progreso es de ejemplo hasta que exista el inicio de sesión. Las estimaciones son orientativas: tu ritmo y tu maestro mandan.</Aviso>

  <!-- ============ REQUISITOS ============ -->
  {parada.requisitos.length > 0 && (
    <section class="mt-12" aria-labelledby="requisitos">
      <EncabezadoSeccion id="requisitos" eyebrow={`${parada.hechos} de ${parada.requisitos.length}`} titulo="Para pasar al jefe" enlace={{ href: "/arbol", texto: "Ver en el árbol" }} />
      <div class="flex flex-wrap gap-2">
        {parada.requisitos.map((r) => <ChipLogro logro={r.logro} estado={r.estado} />)}
      </div>
    </section>
  )}

  <!-- ============ TEMARIO ============ -->
  <section class="mt-12" aria-labelledby="temario">
    <EncabezadoSeccion id="temario" eyebrow="Lo que se estudia aquí" titulo="Temario" />
    <TemarioZona temario={n.temario} />
  </section>

  <!-- ============ JEFE(S) ============ -->
  <section class="mt-12 grid gap-6" aria-labelledby="jefe">
    <EncabezadoSeccion id="jefe" eyebrow="Al final de la zona" titulo={parada.jefes.length > 1 ? "Los jefes" : "El jefe"} />
    {parada.jefes.map((j) => <TarjetaJefe jefe={j.jefe} cancion={j.cancion} />)}
  </section>

  <!-- ============ CANCIONES ============ -->
  {canciones.length > 0 && (
    <section class="mt-12" aria-labelledby="canciones">
      <EncabezadoSeccion id="canciones" eyebrow={`${canciones.length} ${canciones.length === 1 ? "obra" : "obras"}`} titulo="Canciones de la zona" />
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {canciones.map((s) => <TarjetaCancion cancion={s} ruta={c.rutaPorId.get(s.data.ruta.id)!} />)}
      </div>
    </section>
  )}

  <!-- ============ OTROS LOGROS ============ -->
  {otrosLogros.length > 0 && (
    <section class="mt-12" aria-labelledby="logros">
      <EncabezadoSeccion id="logros" eyebrow="Opcionales" titulo="Otros logros de la zona" />
      <div class="flex flex-wrap gap-2">
        {otrosLogros.map((r) => <ChipLogro logro={r.logro} estado={r.estado} />)}
      </div>
    </section>
  )}

  <NavegacionVecinos anterior={vecino(paradas[i - 1])} siguiente={vecino(paradas[i + 1])} />
</Base>
