---
/**
 * Página / (portada): qué toca esta noche y dónde vas. Dirección visual
 * «Nocturno», paleta «Cian» (sacada de la imagen principal): imagen grande, los 90 días como partitura, la sesión, la
 * puerta del próximo jefe, el sendero de zonas y las rutas del repertorio.
 *
 * Progreso: de ejemplo (`PROGRESO_EJEMPLO`), porque la página es pública y estática;
 * el progreso real está en /panel. «Hoy» es la fecha del build.
 */
import { Picture, getImage } from "astro:assets";
import Base from "@/layouts/Base.astro";
import EncabezadoSeccion from "@/components/ui/EncabezadoSeccion.astro";
import ResumenSesion from "@/components/sesion/ResumenSesion.astro";
import PartituraNoventaDias from "@/components/calendario/PartituraNoventaDias";
import AnuncioJefe from "@/components/jefes/AnuncioJefe.astro";
import SenderoPortada from "@/components/mapa/SenderoPortada.astro";
import IndiceRutas, { type RutaIndice } from "@/components/canciones/IndiceRutas";
import { cargarContenido, nombreCortoRuta } from "@/lib/contenido";
import { diasParaPartitura, minutosDelDia, sesionDeReferencia, titularDelDia } from "@/lib/calendario";
import { diaDelPlan, fechaLarga } from "@/lib/fechas";
import { sumarMinutos } from "@/lib/formato";
import { construirSendero } from "@/lib/mapa";
import { diaDelJefe } from "@/lib/jefes";
import { PROGRESO_EJEMPLO } from "@/lib/ejemplo";
import { HORARIO } from "@/config/sitio";
import { IMAGENES, IMAGEN_RUTA } from "@/config/imagenes";

const c = await cargarContenido();
const partitura = diasParaPartitura(c);
const hoy = diaDelPlan(new Date(), partitura[0].fecha);
const { dia: sesion, motivo } = sesionDeReferencia(c.dias, hoy);
const s = sesion.data;
const minutos = minutosDelDia(sesion);

const paradas = construirSendero(c, PROGRESO_EJEMPLO);
const actual = paradas.find((p) => p.estado === "actual") ?? paradas[paradas.length - 1];
const proximo = paradas.flatMap((p) => p.jefes.map((j) => ({ ...j, zona: p.nivel.data.orden }))).find((j) => !j.vencido);
const diaJefe = proximo && diaDelJefe(c, proximo.jefe.id)?.data.numero;

// Lo que dice la línea pequeña sobre el título, según el momento del plan.
const titular = titularDelDia(hoy);
const antetitulo = {
  hoy: `Día ${hoy} de ${partitura.length} · ${actual.nivel.data.nombre}`,
  proxima: hoy < 1 ? `Empiezas ${titular.enfasis} · tu primera sesión` : `Hoy descansas · la próxima es el día ${s.numero}`,
  terminado: `Los ${partitura.length} días terminaron · la última sesión`,
}[motivo];

// Las rutas, con su imagen ya optimizada: la isla recibe solo URLs y medidas.
const rutas: RutaIndice[] = await Promise.all(
  c.rutas.map(async (r) => {
    const img = await getImage({ src: (IMAGEN_RUTA[r.id] ?? IMAGENES.animeDorada).src, width: 448, format: "webp" });
    return {
      id: r.id,
      nombre: nombreCortoRuta(r),
      descripcion: r.data.descripcion,
      obras: c.canciones.filter((x) => x.data.ruta.id === r.id).length,
      color: r.data.color,
      imagen: { src: img.src, width: Number(img.attributes.width), height: Number(img.attributes.height) },
    };
  }),
);

const portada = IMAGENES.animeCian;
const totalJefes = c.jefes.length;
---

<Base titulo="Inicio" ancho="completo">
  <!-- ============ PORTADA: esta noche ============ -->
  <section class="contenedor grid gap-8 pt-4 lg:grid-cols-[1fr_1.12fr] lg:gap-0 lg:pt-8" aria-labelledby="titulo-portada">
    <div class="flex flex-col justify-center py-4 lg:py-16 lg:pr-14" data-revelar="hijos">
      <p class="flex flex-wrap gap-x-4 gap-y-1 font-mono text-[0.6875rem] tracking-wide text-tenue uppercase">
        <span>{fechaLarga(s.fecha)}</span>
        <span><span class="text-acento">{HORARIO.inicio}</span> – {sumarMinutos(HORARIO.inicio, minutos)}</span>
        <span>{s.fase === "sin-flauta" ? "sin flauta" : "con flauta"}</span>
      </p>
      <h1 id="titulo-portada" class="mt-6 text-[3.25rem] leading-[0.92] tracking-[-0.02em] sm:text-7xl xl:text-[6.5rem]">
        <span class="mb-4 block font-sans text-base font-semibold tracking-normal text-tenue">{antetitulo}</span>
        {s.titulo}
      </h1>
      <p class="mt-6 max-w-[44ch] text-lg leading-relaxed text-tenue">
        {s.objetivo} {s.bloques.length} bloques, {minutos} minutos.
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a href={`/dias/${s.numero}`} class="boton">Empezar la sesión <span aria-hidden="true">→</span></a>
        <a href="/calendario" class="boton-borde">Ver la semana</a>
      </div>
      <p class="mt-8 font-mono text-[0.625rem] text-tenue uppercase">
        Progreso de ejemplo · <a href="/entrar" class="text-acento underline-offset-4 hover:underline">entra</a> para llevar el tuyo
      </p>
    </div>

    <div class="relative min-h-[24rem] overflow-hidden rounded-md sm:min-h-[30rem] lg:min-h-[40rem]" data-marco>
      <!-- El zoom lento va en el marco y el paralaje en la imagen: dos transformaciones distintas que no se pisan. -->
      <div class="absolute inset-0 animate-acercar">
        <Picture
          src={portada.src}
          alt={portada.alt}
          widths={[640, 960, 1280, 1600, 2000]}
          sizes="(min-width: 1024px) 55vw, 100vw"
          formats={["avif"]}
          fallbackFormat="webp"
          loading="eager"
          fetchpriority="high"
          class="absolute -top-[6%] left-0 h-[112%] w-full object-cover"
          style={{ objectPosition: portada.enfoque }}
          data-paralaje
        />
      </div>
      <div class="absolute inset-0 bg-linear-to-t from-fondo/85 via-transparent to-transparent lg:bg-linear-to-r lg:from-fondo lg:via-fondo/10" aria-hidden="true"></div>
      <!-- Pentagrama sobre la imagen: la misma pauta que la partitura de abajo. -->
      <svg class="absolute inset-x-0 bottom-[18%] h-14 w-full text-texto mix-blend-overlay" viewBox="0 0 100 56" preserveAspectRatio="none" aria-hidden="true">
        {[0, 1, 2, 3, 4].map((k) => <line x1="0" x2="100" y1={4 + k * 12} y2={4 + k * 12} stroke="currentColor" stroke-width="0.6" vector-effect="non-scaling-stroke" opacity="0.7" />)}
      </svg>
      <p class="absolute right-5 bottom-5 text-right font-mono text-[0.625rem] leading-relaxed text-texto/80 uppercase">
        Semana {s.semana} de {Math.max(...partitura.map((d) => d.semana))}<br />
        Zona {actual.nivel.data.orden} · {actual.nivel.data.zona}
      </p>
    </div>
  </section>

  <!-- ============ LOS 90 DÍAS ============ -->
  <section class="contenedor mt-24 sm:mt-32" aria-labelledby="titulo-partitura">
    <EncabezadoSeccion
      id="titulo-partitura"
      eyebrow={`${partitura.length} días · ${partitura.filter((d) => !d.descanso).length} sesiones`}
      titulo="Noventa días en una partitura"
      descripcion="Cada nota es una sesión; los silencios, tus descansos; las barras dobles, los jefes. La melodía sube a medida que avanzas."
      enlace={{ href: "/calendario", texto: "Calendario completo" }}
      tamano="grande"
    />
    <PartituraNoventaDias client:load dias={partitura} hoy={hoy} />
  </section>

  <!-- ============ ESTA NOCHE + EL JEFE ============ -->
  <section class="contenedor mt-24 grid gap-6 sm:mt-32 lg:grid-cols-[1.15fr_1fr]" aria-label="Sesión y próximo jefe">
    <div data-revelar>
      <ResumenSesion
        dia={sesion}
        class="h-full"
        etiqueta={{ hoy: "Esta noche", proxima: hoy < 1 ? "Tu primera sesión" : "Próxima sesión", terminado: "Última sesión del plan" }[motivo]}
      />
    </div>
    {proximo && (
      <div data-revelar>
        <AnuncioJefe
          jefe={proximo.jefe}
          cancion={proximo.cancion}
          zona={proximo.zona}
          diaDelPlan={diaJefe}
          diasRestantes={diaJefe !== undefined && hoy <= diaJefe ? diaJefe - Math.max(hoy, 0) : undefined}
          class="h-full"
        />
      </div>
    )}
  </section>

  <!-- ============ EL SENDERO ============ -->
  <section class="contenedor mt-24 sm:mt-32" aria-labelledby="titulo-sendero">
    <EncabezadoSeccion
      id="titulo-sendero"
      eyebrow={`${c.niveles.length} zonas · ${totalJefes} jefes · ${c.logros.length} logros`}
      titulo={`Hasta la ${c.niveles[c.niveles.length - 1].data.nombre}`}
      descripcion="Un temario serio de flauta traversa, organizado como un juego. Lo cercano se ve claro; lo lejano está en la niebla. Llegar arriba lleva años, y está bien."
      enlace={{ href: "/mapa", texto: "Ver el mapa" }}
      tamano="grande"
    />
    <SenderoPortada paradas={paradas} />
  </section>

  <!-- ============ RUTAS ============ -->
  <section class="contenedor mt-24 sm:mt-32" aria-labelledby="titulo-rutas">
    <EncabezadoSeccion
      id="titulo-rutas"
      eyebrow={`Repertorio · ${c.canciones.length} obras`}
      titulo="Elige por dónde ir"
      descripcion="Las rutas se cruzan: cada canción vive en la zona donde ya tienes lo que exige."
      enlace={{ href: "/canciones", texto: "Todo el catálogo" }}
      tamano="grande"
    />
    <IndiceRutas client:visible rutas={rutas} />
  </section>
</Base>
