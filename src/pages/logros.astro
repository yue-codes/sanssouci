---
/**
 * Página /logros: el libro de logros. Complementa al árbol (que enseña las
 * dependencias): aquí se leen en orden, agrupados por la zona en que se
 * sugieren, con lo que tienes al alcance arriba.
 * Datos: `logrosConEstado`, `usosDeLogros`, `avancePorCategoria` (src/lib/logros.ts).
 * Progreso: de ejemplo hasta la fase 4.
 */
import { Sparkles } from "lucide-preact";
import Base from "@/layouts/Base.astro";
import Aviso from "@/components/ui/Aviso.astro";
import AnilloProgreso from "@/components/ui/AnilloProgreso";
import EncabezadoSeccion from "@/components/ui/EncabezadoSeccion.astro";
import AvanceCategorias from "@/components/logros/AvanceCategorias.astro";
import TarjetaLogro from "@/components/logros/TarjetaLogro.astro";
import { ICONO_CATEGORIA, ORDEN_RAMAS } from "@/components/logros/categorias";
import { cargarContenido } from "@/lib/contenido";
import { avancePorCategoria, logrosConEstado, usosDeLogros } from "@/lib/logros";
import { PROGRESO_EJEMPLO } from "@/lib/ejemplo";

const c = await cargarContenido();
const { obtenidos } = PROGRESO_EJEMPLO;

// Dentro de cada zona, por rama (el mismo orden que el árbol) y luego por nombre.
const ordenRama = (l: (typeof c.logros)[number]) => ORDEN_RAMAS.indexOf(l.data.categoria);
const ordenados = [...c.logros].sort(
  (a, b) => ordenRama(a) - ordenRama(b) || a.data.nombre.localeCompare(b.data.nombre, "es"),
);
const todos = logrosConEstado(c, ordenados.map((l) => l.id), obtenidos);
const usos = usosDeLogros(c);
const requisitos = (id: string) => logrosConEstado(c, c.logroPorId.get(id)!.data.requiere.map((r) => r.id), obtenidos);

const conseguidos = todos.filter((t) => t.estado === "conseguido").length;
const alAlcance = todos.filter((t) => t.estado === "disponible");
const zonas = c.niveles
  .map((n) => ({ nivel: n, logros: todos.filter((t) => t.logro.data.nivelSugerido.id === n.id) }))
  .filter((z) => z.logros.length > 0);
---

<Base titulo="Logros" descripcion="Todos los logros del camino: cómo se consigue cada uno, qué requiere y qué abre.">
  <Aviso class="mb-6">El progreso es de ejemplo hasta que exista el inicio de sesión.</Aviso>

  <!-- ============ CABECERA ============ -->
  <header class="flex flex-wrap items-center justify-between gap-8">
    <div class="max-w-2xl">
      <p class="eyebrow">Libro de logros · {todos.length} en total</p>
      <h1 class="mt-3 text-4xl leading-tight font-semibold sm:text-6xl">Logros</h1>
      <p class="mt-4 text-lg leading-relaxed text-tenue">
        Cada logro tiene un criterio claro para darlo por conseguido. Aquí están en el orden en que llegan;
        en el <a href="/arbol" class="font-medium text-acento hover:underline">árbol</a> se ve cómo se conectan.
      </p>
    </div>
    <AnilloProgreso valor={conseguidos / todos.length} etiqueta={`${conseguidos} / ${todos.length}`} tamano={140} />
  </header>

  <!-- ============ AVANCE POR RAMA ============ -->
  <section class="tarjeta mt-10 p-6" aria-labelledby="ramas">
    <EncabezadoSeccion id="ramas" eyebrow="Avance" titulo="Por rama" enlace={{ href: "/arbol", texto: "Ver el árbol" }} />
    <AvanceCategorias avance={avancePorCategoria(todos, ORDEN_RAMAS)} />
  </section>

  <!-- ============ AL ALCANCE ============ -->
  {alAlcance.length > 0 && (
    <section class="mt-12" aria-labelledby="alcance">
      <EncabezadoSeccion id="alcance" eyebrow={`${alAlcance.length} logros`} titulo="Al alcance ahora" />
      <p class="-mt-2 mb-5 max-w-2xl text-sm text-tenue">Ya tienes todo lo que piden: puedes ir por ellos hoy.</p>
      <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {alAlcance.map(({ logro }) => {
          const Icono = ICONO_CATEGORIA[logro.data.categoria];
          return (
            <li>
              <a href={`#${logro.id}`} class="tarjeta flex h-full items-start gap-3 border-resalte/40 p-4 transition hover:border-resalte">
                <span class="grid size-9 shrink-0 place-items-center rounded-lg border border-resalte/60 text-resalte">
                  <Icono size={18} aria-hidden="true" />
                </span>
                <span>
                  <span class="flex items-center gap-1.5 font-semibold">
                    {logro.data.nombre} <Sparkles size={14} class="text-resalte" aria-hidden="true" />
                  </span>
                  <span class="mt-0.5 line-clamp-2 block text-xs text-tenue">{logro.data.criterio}</span>
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  )}

  <!-- ============ ÍNDICE DE ZONAS ============ -->
  <nav class="mt-12 flex flex-wrap gap-2" aria-label="Zonas">
    {zonas.map(({ nivel, logros }) => (
      <a href={`#zona-${nivel.data.orden}`} class="rounded-full border border-borde px-3 py-1 text-sm hover:bg-superficie-2">
        Zona {nivel.data.orden} <span class="text-tenue">· {logros.length}</span>
      </a>
    ))}
  </nav>

  <!-- ============ LOGROS POR ZONA ============ -->
  {zonas.map(({ nivel, logros }) => {
    const hechos = logros.filter((t) => t.estado === "conseguido").length;
    return (
      <section id={`zona-${nivel.data.orden}`} class="mt-12 scroll-mt-24" aria-labelledby={`titulo-zona-${nivel.data.orden}`}>
        <EncabezadoSeccion
          id={`titulo-zona-${nivel.data.orden}`}
          eyebrow={`Zona ${nivel.data.orden} · ${hechos} de ${logros.length} conseguidos`}
          titulo={nivel.data.nombre}
          enlace={{ href: `/niveles/${nivel.id}`, texto: "Ver la zona" }}
        />
        <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
          {logros.map(({ logro, estado }) => (
            <TarjetaLogro logro={logro} estado={estado} requiere={requisitos(logro.id)} usos={usos.get(logro.id)} />
          ))}
        </div>
      </section>
    );
  })}
</Base>
