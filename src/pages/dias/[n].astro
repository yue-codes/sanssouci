---
/**
 * Página /dias/[n]: un día del plan como «misión del día».
 * Arriba, la portada con la imagen de su zona (o de su jefe), el objetivo y el
 * recorrido de los 90 días (`RecorridoPlan`). Debajo, el combate si hay jefe
 * (`AnuncioJefe`), la sesión como misión con cronómetro y las recompensas posibles.
 * La misión y sus recompensas son una Server Island (`MisionConProgreso`,
 * `server:defer`): la página sigue siendo estática y solo ese trozo se genera en
 * cada visita, con tu sesión (si el día ya está guardado, qué talentos tienes). Los días de descanso son un campamento.
 * `getStaticPaths` genera las 90 páginas (/dias/1 … /dias/90).
 */
import { getCollection } from "astro:content";
import { Clock, Lightbulb, Moon, Target, Tent } from "lucide-preact";
import FondoPortada from "@/components/ui/FondoPortada.astro";
import Base from "@/layouts/Base.astro";
import MigasDePan from "@/components/ui/MigasDePan.astro";
import EncabezadoSeccion from "@/components/ui/EncabezadoSeccion.astro";
import NavegacionVecinos from "@/components/ui/NavegacionVecinos.astro";
import MisionConProgreso from "@/components/sesion/MisionConProgreso.astro";
import AnuncioJefe from "@/components/jefes/AnuncioJefe.astro";
import RecorridoPlan from "@/components/calendario/RecorridoPlan.astro";
import { HITO } from "@/components/calendario/hitos";
import { cargarContenido } from "@/lib/contenido";
import { hitosDelDia, minutosDelDia, primerDiaConFlauta, zonaDelDia } from "@/lib/calendario";
import { fechaLarga, fechaCorta } from "@/lib/fechas";
import { IMAGEN_ZONA, IMAGENES, imagenDeJefe } from "@/config/imagenes";

export async function getStaticPaths() {
  const dias = await getCollection("dias");
  return dias.map((d) => ({ params: { n: String(d.data.numero) } }));
}

const numero = Number(Astro.params.n);
const c = await cargarContenido();
const dias = [...c.dias].sort((a, b) => a.data.numero - b.data.numero);
const i = dias.findIndex((x) => x.data.numero === numero);
const dia = dias[i];
const d = dia.data;
const descanso = d.tipo === "descanso";
const conFlauta = primerDiaConFlauta(dias);
const hitos = hitosDelDia(dia, conFlauta);
const jefe = d.jefe && c.jefePorId.get(d.jefe.id)!;
const zona = zonaDelDia(c, numero);
const siguientePractica = dias.slice(i + 1).find((x) => x.data.tipo !== "descanso");

// La imagen: la del jefe en su día, una tranquila en los descansos y la de la zona el resto.
const imagen = jefe ? imagenDeJefe(jefe.id) : descanso ? IMAGENES.siluetaVentana : (IMAGEN_ZONA[zona.id] ?? IMAGENES.animeCian);

const vecino = (x?: (typeof dias)[number]) =>
  x && { href: `/dias/${x.data.numero}`, etiqueta: `Día ${x.data.numero} · ${fechaCorta(x.data.fecha)}`, titulo: x.data.titulo };
---

<Base titulo={`Día ${d.numero}: ${d.titulo}`} descripcion={d.objetivo} ancho="completo">
  <!-- ============ PORTADA ============ -->
  <section class:list={["relative isolate overflow-hidden border-b", jefe ? "border-peligro/30" : "border-borde"]} aria-labelledby="titulo-dia">
    <FondoPortada imagen={imagen} />

    <div class="contenedor pt-8 pb-12 sm:pb-16">
      <MigasDePan items={[{ texto: "Calendario", href: "/calendario" }, { texto: `Día ${d.numero}` }]} />

      <div class="mt-8 max-w-3xl" data-revelar="hijos">
        <p class="eyebrow">
          {descanso ? "Día de descanso" : d.sesion ? `Misión ${d.sesion} de 65` : "Día opcional"} · Semana {d.semana} · {d.fase === "sin-flauta" ? "sin flauta" : "con flauta"}
        </p>
        <h1 id="titulo-dia" class="mt-4 text-5xl leading-[0.95] sm:text-7xl">{d.titulo}</h1>
        <p class="mt-4 text-tenue">
          <span class="inline-block text-texto first-letter:uppercase">{fechaLarga(d.fecha)}</span>{" · "}<a href={`/niveles/${zona.id}`} class="hover:text-acento-claro">Zona {zona.data.orden} · {zona.data.nombre}</a>
        </p>

        <p class="mt-6 flex max-w-[60ch] gap-3 text-lg leading-relaxed">
          <Target size={20} class="mt-1 shrink-0 text-acento" aria-hidden="true" />
          <span><span class="sr-only">Objetivo: </span>{d.objetivo}</span>
        </p>

        <div class="mt-6 flex flex-wrap gap-2 text-sm">
          {!descanso && (
            <span class="inline-flex items-center gap-1.5 rounded-[3px] border border-borde bg-fondo/60 px-2.5 py-1 backdrop-blur-sm">
              <Clock size={14} aria-hidden="true" /> {minutosDelDia(dia)} min
            </span>
          )}
          {hitos.map((h) => {
            const { nombre, Icono, clase } = HITO[h];
            return (
              <span class:list={["inline-flex items-center gap-1.5 rounded-[3px] border border-borde bg-fondo/60 px-2.5 py-1 font-medium backdrop-blur-sm", clase]}>
                <Icono size={14} aria-hidden="true" /> {nombre}
              </span>
            );
          })}
        </div>
      </div>

      <div class="mt-10 max-w-4xl" data-revelar>
        <RecorridoPlan dias={dias} actual={d.numero} primerConFlauta={conFlauta} />
      </div>
    </div>
  </section>

  <div class="contenedor py-14 sm:py-20">
    {d.notas && (
      <p class="mb-12 flex max-w-3xl gap-3 rounded-md border border-resalte/30 bg-resalte/5 p-4 text-sm leading-relaxed">
        <Lightbulb size={18} class="mt-0.5 shrink-0 text-resalte" aria-hidden="true" />
        <span><span class="font-semibold text-resalte">Nota:</span> {d.notas}</span>
      </p>
    )}

    <!-- ============ JEFE ============ -->
    {jefe && (
      <section class="mb-16" aria-labelledby="jefe-del-dia">
        <EncabezadoSeccion id="jefe-del-dia" eyebrow="Hoy hay combate" titulo="El jefe del día" />
        <AnuncioJefe jefe={jefe} cancion={c.cancionPorId.get(jefe.data.cancion.id)!} zona={zona.data.orden} diaDelPlan={d.numero} etiqueta="Combate de hoy" />
      </section>
    )}

    <!-- ============ SESIÓN ============ -->
    {descanso ? (
      <section class="grid max-w-3xl gap-6 rounded-md border border-borde bg-superficie p-6 sm:grid-cols-[auto_1fr] sm:p-8" aria-labelledby="campamento">
        <span class="grid size-14 place-items-center rounded-full bg-secundario/15 text-secundario" aria-hidden="true"><Tent size={26} /></span>
        <div>
          <p class="eyebrow flex items-center gap-2"><Moon size={13} aria-hidden="true" /> Campamento</p>
          <h2 id="campamento" class="mt-2 text-4xl">Hoy se descansa</h2>
          <p class="mt-3 max-w-[60ch] leading-relaxed text-tenue">
            No es tiempo perdido: los labios, la respiración y la memoria se consolidan mientras descansas.
            Si te apetece, escucha a un flautista sin analizar nada.
          </p>
          {siguientePractica && (
            <a href={`/dias/${siguientePractica.data.numero}`} class="enlace-flecha mt-5">
              Próxima misión: día {siguientePractica.data.numero} · {siguientePractica.data.titulo} <span aria-hidden="true">→</span>
            </a>
          )}
        </div>
      </section>
    ) : (
      <section aria-labelledby="sesion">
        <EncabezadoSeccion id="sesion" eyebrow="Calentamiento → técnica → estudios → repertorio" titulo="La misión" descripcion="Cada bloque es una etapa. Márcala al terminarla, o juégala con el cronómetro." />
        <MisionConProgreso server:defer numero={d.numero}>
          <!-- Mientras llega del servidor: un esqueleto con la forma de la misión. -->
          <div slot="fallback" class="grid gap-8 lg:grid-cols-[16rem_1fr]" aria-busy="true">
            <p class="sr-only">Cargando la misión…</p>
            <div class="h-64 animate-pulse rounded-md border border-borde bg-superficie" aria-hidden="true"></div>
            <div class="grid gap-3" aria-hidden="true">
              {d.bloques.map(() => <div class="h-24 animate-pulse rounded-md border border-borde bg-superficie/70"></div>)}
            </div>
          </div>
        </MisionConProgreso>
      </section>
    )}

    <NavegacionVecinos anterior={vecino(dias[i - 1])} siguiente={vecino(dias[i + 1])} />
  </div>
</Base>
