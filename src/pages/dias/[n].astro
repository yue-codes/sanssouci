---
/**
 * Página /dias/[n]: un día del plan. Sesión con sus bloques (marcables, demo
 * hasta la fase 4), logros posibles, jefe del día y notas.
 * `getStaticPaths` genera las 90 páginas (/dias/1 … /dias/90).
 */
import { getCollection } from "astro:content";
import { Clock, Moon } from "lucide-preact";
import Base from "@/layouts/Base.astro";
import Aviso from "@/components/ui/Aviso.astro";
import MigasDePan from "@/components/ui/MigasDePan.astro";
import EncabezadoSeccion from "@/components/ui/EncabezadoSeccion.astro";
import NavegacionVecinos from "@/components/ui/NavegacionVecinos.astro";
import SesionDelDia from "@/components/sesion/SesionDelDia";
import ChipLogro from "@/components/logros/ChipLogro.astro";
import TarjetaJefe from "@/components/jefes/TarjetaJefe.astro";
import { HITO } from "@/components/calendario/hitos";
import { cargarContenido } from "@/lib/contenido";
import { hitosDelDia, minutosDelDia, primerDiaConFlauta } from "@/lib/calendario";
import { logrosConEstado } from "@/lib/logros";
import { fechaLarga, fechaCorta } from "@/lib/fechas";
import { PROGRESO_EJEMPLO } from "@/lib/ejemplo";

export async function getStaticPaths() {
  const dias = await getCollection("dias");
  return dias.map((d) => ({ params: { n: String(d.data.numero) } }));
}

const numero = Number(Astro.params.n);
const c = await cargarContenido();
const dias = [...c.dias].sort((a, b) => a.data.numero - b.data.numero);
const i = dias.findIndex((x) => x.data.numero === numero);
const dia = dias[i];
const d = dia.data;
const descanso = d.tipo === "descanso";
const hitos = hitosDelDia(dia, primerDiaConFlauta(dias));
const logros = logrosConEstado(c, d.logrosPosibles.map((l) => l.id), PROGRESO_EJEMPLO.obtenidos);
const jefe = d.jefe && c.jefePorId.get(d.jefe.id)!;

const vecino = (x?: (typeof dias)[number]) =>
  x && { href: `/dias/${x.data.numero}`, etiqueta: `Día ${x.data.numero} · ${fechaCorta(x.data.fecha)}`, titulo: x.data.titulo };
---

<Base titulo={`Día ${d.numero}: ${d.titulo}`} descripcion={d.objetivo}>
  <MigasDePan items={[{ texto: "Calendario", href: "/calendario" }, { texto: `Día ${d.numero}` }]} />

  <!-- ============ CABECERA ============ -->
  <header class="max-w-3xl">
    <p class="eyebrow">Día {d.numero} de 90 · Semana {d.semana} · {d.fase === "sin-flauta" ? "sin flauta" : "con flauta"}</p>
    <h1 class="mt-3 text-4xl font-semibold leading-tight sm:text-6xl">{d.titulo}</h1>
    <p class="mt-3 text-lg text-tenue first-letter:uppercase">{fechaLarga(d.fecha)}</p>
    <p class="mt-4 text-lg leading-relaxed">{d.objetivo}</p>

    <div class="mt-5 flex flex-wrap gap-2 text-sm">
      {!descanso && (
        <span class="inline-flex items-center gap-1.5 rounded-full border border-borde px-3 py-1">
          <Clock size={14} aria-hidden="true" /> {minutosDelDia(dia)} min{d.sesion && ` · sesión ${d.sesion} de 65`}
        </span>
      )}
      {hitos.map((h) => {
        const { nombre, Icono, clase } = HITO[h];
        return (
          <span class:list={["inline-flex items-center gap-1.5 rounded-full border border-borde px-3 py-1 font-medium", clase]}>
            <Icono size={14} aria-hidden="true" /> {nombre}
          </span>
        );
      })}
    </div>
  </header>

  {d.notas && <Aviso class="mt-6">{d.notas}</Aviso>}

  <!-- ============ SESIÓN ============ -->
  {descanso ? (
    <section class="tarjeta mt-10 flex items-center gap-4 p-6" aria-label="Descanso">
      <span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-superficie-2 text-secundario"><Moon size={22} aria-hidden="true" /></span>
      <p class="leading-relaxed">Hoy toca descansar. No es tiempo perdido: los labios, la respiración y la memoria se consolidan mientras descansas.</p>
    </section>
  ) : (
    <section class="mt-10" aria-labelledby="sesion">
      <EncabezadoSeccion id="sesion" eyebrow="Calentamiento → técnica → estudios → repertorio" titulo="La sesión" />
      <div class="tarjeta p-5 sm:p-6">
        <SesionDelDia client:visible bloques={d.bloques} />
      </div>
      <p class="mt-2 text-xs text-tenue">Marcar bloques es una demostración: aún no se guarda (llegará con el inicio de sesión).</p>
    </section>
  )}

  <!-- ============ JEFE ============ -->
  {jefe && (
    <section class="mt-12" aria-labelledby="jefe-del-dia">
      <EncabezadoSeccion id="jefe-del-dia" eyebrow="Hoy es la batalla" titulo="El jefe del día" />
      <TarjetaJefe jefe={jefe} cancion={c.cancionPorId.get(jefe.data.cancion.id)!} />
    </section>
  )}

  <!-- ============ LOGROS ============ -->
  {logros.length > 0 && (
    <section class="mt-12" aria-labelledby="logros-del-dia">
      <EncabezadoSeccion id="logros-del-dia" eyebrow="Si lo consigues hoy" titulo="Logros posibles" enlace={{ href: "/arbol", texto: "Ver en el árbol" }} />
      <div class="flex flex-wrap gap-2">
        {logros.map((r) => <ChipLogro logro={r.logro} estado={r.estado} />)}
      </div>
    </section>
  )}

  <NavegacionVecinos anterior={vecino(dias[i - 1])} siguiente={vecino(dias[i + 1])} />
</Base>
