---
/**
 * Muestra de la opción C: árbol de talentos estilo RPG.
 * Los nodos y las líneas salen de logros.json; el progreso es de ejemplo.
 */
import "@fontsource-variable/pixelify-sans";
import Base from "../../layouts/Base.astro";
import PestanasMuestra from "../../components/ui/PestanasMuestra.astro";
import ArbolTalentos, { type NodoTalento } from "../../components/islas/ArbolTalentos";
import { ORDEN_RAMAS } from "../../components/ui/categorias";
import { cargarContenido } from "../../lib/contenido";
import { posicionarArbol } from "../../lib/arbol";
import { OBTENIDOS_EJEMPLO } from "../../lib/ejemplo";

const c = await cargarContenido();

// A la isla solo le pasamos datos planos (lo que necesita), no las entradas completas:
// todo lo que recibe una isla se escribe en el HTML para que el navegador lo lea.
const planos = c.logros.map((l) => ({
  id: l.id,
  nombre: l.data.nombre,
  categoria: l.data.categoria,
  descripcion: l.data.descripcion,
  criterio: l.data.criterio,
  requiere: l.data.requiere.map((r) => r.id),
  zona: `Zona ${c.nivelPorId.get(l.data.nivelSugerido.id)!.data.orden}`,
}));
const nodos: NodoTalento[] = posicionarArbol(planos, ORDEN_RAMAS);
---

<Base titulo="Muestra C: árbol de talentos">
  <PestanasMuestra />

  <header class="max-w-3xl">
    <p class="eyebrow">Opción C · Árbol de talentos</p>
    <h1 class="mt-3 font-pixel text-4xl leading-tight font-semibold sm:text-6xl">Tus habilidades</h1>
    <p class="mt-4 text-lg leading-relaxed text-tenue">
      Cada columna es una rama del temario y cada línea, un requisito.
      Lo <span class="text-aurora">azul</span> lo puedes conseguir ya; lo <span class="text-oro">dorado</span> ya es tuyo.
      Toca un talento para ver cómo se consigue y qué abre.
    </p>
  </header>

  <div class="mt-8">
    <ArbolTalentos client:load nodos={nodos} ramas={ORDEN_RAMAS} obtenidos={[...OBTENIDOS_EJEMPLO]} />
  </div>
</Base>
