---
/**
 * Muestra de la opción A: el mapa como un sendero que baja zona por zona,
 * con un jefe como puerta al final de cada tramo.
 * Lo cercano se ve con detalle; lo lejano, en niebla y resumido.
 */
import Base from "../../layouts/Base.astro";
import PestanasMuestra from "../../components/ui/PestanasMuestra.astro";
import ChipLogro from "../../components/ui/ChipLogro.astro";
import { cargarContenido } from "../../lib/contenido";
import { estadoLogro } from "../../lib/progreso";
import { OBTENIDOS_EJEMPLO, ZONA_ACTUAL_EJEMPLO } from "../../lib/ejemplo";
import { Check, Footprints, Lock, Swords, ArrowRight, Music2 } from "lucide-preact";

const c = await cargarContenido();
const obtenidos = new Set(OBTENIDOS_EJEMPLO);

const zonas = c.niveles.map((n) => {
  const orden = n.data.orden;
  const estado = orden < ZONA_ACTUAL_EJEMPLO ? "superada" : orden === ZONA_ACTUAL_EJEMPLO ? "actual" : "bloqueada";
  const requisitos = n.data.requisitosParaPasar.map((r) => {
    const logro = c.logroPorId.get(r.id)!;
    return { logro, estado: estadoLogro(logro.id, logro.data.requiere.map((x) => x.id), obtenidos) };
  });
  const jefe = c.jefePorId.get(n.data.jefe.id)!;
  return {
    nivel: n,
    estado,
    // Más de una zona por delante = "niebla": se ve, pero sin detalle.
    lejana: orden > ZONA_ACTUAL_EJEMPLO + 1,
    requisitos,
    hechos: requisitos.filter((r) => r.estado === "conseguido").length,
    jefe,
    cancion: c.cancionPorId.get(jefe.data.cancion.id)!,
  };
});

const actual = zonas[ZONA_ACTUAL_EJEMPLO];
const siguientePaso = actual.requisitos.find((r) => r.estado === "disponible");
---

<Base titulo="Muestra A: sendero">
  <PestanasMuestra />

  <!-- ============ DÓNDE ESTÁS ============ -->
  <section class="tarjeta relative overflow-hidden p-6 sm:p-8">
    <p class="eyebrow">Opción A · Sendero · Estás aquí</p>
    <h1 class="mt-3 text-4xl font-semibold leading-tight sm:text-6xl">
      {actual.nivel.data.nombre}
    </h1>
    <p class="mt-2 text-lg text-tenue">Zona {actual.nivel.data.orden} · {actual.nivel.data.zona}</p>

    <div class="mt-6 grid gap-4 md:grid-cols-[1fr_auto] md:items-end">
      <div>
        <div class="flex items-baseline justify-between text-sm">
          <span class="font-medium">Para cruzar al jefe</span>
          <span class="text-tenue">{actual.hechos} de {actual.requisitos.length} requisitos</span>
        </div>
        <div class="mt-2 h-2.5 overflow-hidden rounded-full bg-borde" role="progressbar" aria-label="Requisitos de la zona" aria-valuemin={0} aria-valuemax={actual.requisitos.length} aria-valuenow={actual.hechos}>
          <div class="h-full rounded-full bg-gradient-to-r from-oro to-oro/70" style={`width:${(actual.hechos / actual.requisitos.length) * 100}%`}></div>
        </div>
      </div>
      {siguientePaso && (
        <a href={`/muestra/arbol#${siguientePaso.logro.id}`} class="group flex items-center gap-3 rounded-xl border border-aurora/50 bg-aurora/10 px-4 py-3 text-sm transition hover:bg-aurora/20">
          <span>
            <span class="block text-xs text-tenue">Siguiente paso</span>
            <span class="font-semibold">{siguientePaso.logro.data.nombre}</span>
          </span>
          <ArrowRight size={18} class="text-aurora transition group-hover:translate-x-1" aria-hidden="true" />
        </a>
      )}
    </div>
  </section>

  <!-- ============ EL SENDERO ============ -->
  <ol class="relative mt-12" aria-label="Zonas del camino">
    {zonas.map((z, i) => {
      const lado = i % 2 === 0 ? "md:col-start-1 md:text-right" : "md:col-start-3";
      const n = z.nivel.data;
      return (
        <>
          <!-- Zona -->
          <li data-estado={z.estado} class={`group relative grid grid-cols-[3rem_1fr] gap-x-4 pb-6 md:grid-cols-[1fr_5rem_1fr] ${z.lejana ? "opacity-55 saturate-50" : ""}`}>
            <!-- Tramo de camino: dorado lo andado, punteado lo que falta -->
            <span aria-hidden="true" class={`absolute top-0 bottom-0 left-6 -translate-x-1/2 md:left-1/2 ${z.estado === "superada" ? "w-1 rounded bg-oro" : z.estado === "actual" ? "w-1 rounded bg-gradient-to-b from-oro to-borde" : "border-l-2 border-dashed border-borde"}`}></span>

            <span class="relative z-10 row-start-1 grid justify-items-center md:col-start-2">
              {z.estado === "actual" && <span class="absolute top-0 size-12 animate-latido rounded-full bg-oro" aria-hidden="true"></span>}
              <span class={`relative grid size-12 place-items-center rounded-full border-2 font-display text-lg font-semibold ${z.estado === "superada" ? "border-exito bg-exito text-fondo" : z.estado === "actual" ? "border-oro bg-oro text-fondo" : "border-borde bg-superficie text-tenue"}`}>
                {z.estado === "superada" ? <Check size={20} aria-hidden="true" /> : z.estado === "actual" ? <Footprints size={20} aria-hidden="true" /> : n.orden}
              </span>
            </span>

            <div class={`row-start-1 ${lado}`}>
              <div class={`tarjeta p-5 text-left ${z.estado === "actual" ? "border-oro shadow-[0_0_0_4px_color-mix(in_oklab,var(--oro)_15%,transparent)]" : ""}`}>
                <p class="eyebrow group-data-[estado=bloqueada]:text-tenue">
                  Zona {n.orden} · {z.estado === "actual" ? "Estás aquí" : z.estado === "superada" ? "Superada" : n.zona}
                </p>
                <h2 class="mt-1 text-2xl font-semibold leading-tight">{n.nombre}</h2>
                <p class="mt-1 text-sm leading-relaxed text-tenue">{n.resumen}</p>
                {z.lejana ? (
                  <p class="mt-3 flex items-center gap-2 text-xs text-tenue"><Lock size={12} aria-hidden="true" /> {z.requisitos.length} requisitos · {n.estimacion}</p>
                ) : (
                  <>
                    <p class="mt-4 text-xs font-semibold text-tenue">Requisitos para pasar ({z.hechos}/{z.requisitos.length})</p>
                    <div class="mt-2 flex flex-wrap gap-1.5">
                      {z.requisitos.map((r) => <ChipLogro logro={r.logro} estado={r.estado} />)}
                    </div>
                    <p class="mt-3 text-xs text-tenue">{n.estimacion}</p>
                  </>
                )}
              </div>
            </div>
          </li>

          <!-- Jefe: la puerta al final del tramo -->
          <li class={`relative grid grid-cols-[3rem_1fr] gap-x-4 pb-10 md:grid-cols-[1fr_5rem_1fr] ${z.lejana ? "opacity-55 saturate-50" : ""}`}>
            <span aria-hidden="true" class={`absolute top-0 bottom-0 left-6 -translate-x-1/2 md:left-1/2 ${z.estado === "superada" ? "w-1 rounded bg-oro" : "border-l-2 border-dashed border-borde"}`}></span>
            <span class="relative z-10 row-start-1 grid justify-items-center md:col-start-2">
              <span class={`mt-1 grid size-9 rotate-45 place-items-center rounded-md border-2 ${z.estado === "superada" ? "border-oro bg-oro text-fondo" : "border-peligro/70 bg-superficie text-peligro"}`}>
                <Swords size={16} class="-rotate-45" aria-hidden="true" />
              </span>
            </span>
            <a href={`/jefes/${z.jefe.id}`} class={`row-start-1 ${lado} group/jefe`}>
              <span class="inline-flex max-w-full items-center gap-3 rounded-xl border border-peligro/30 bg-superficie/70 px-4 py-2.5 text-left text-sm transition hover:border-peligro/70">
                <span class="min-w-0">
                  <span class="block text-[11px] font-semibold uppercase tracking-wider text-peligro">Jefe{z.jefe.data.final ? " final" : ""}</span>
                  <span class="block font-display text-lg font-semibold leading-tight">{z.jefe.data.nombre}</span>
                  <span class="flex items-center gap-1.5 text-xs text-tenue"><Music2 size={12} aria-hidden="true" /> {z.cancion.data.titulo} · {z.jefe.data.condicionVictoria.tempo}</span>
                </span>
              </span>
            </a>
          </li>
        </>
      );
    })}
  </ol>
</Base>
