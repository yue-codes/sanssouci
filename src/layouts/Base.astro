---
/**
 * @layout Base
 * Esqueleto HTML de todas las páginas: <head>, enlace «saltar al contenido»,
 * cabecera, contenido principal (`<slot />`) y pie.
 *
 * @example
 * <Base titulo="Mapa" descripcion="Las nueve zonas del camino">…</Base>
 */
import "@/styles/global.css";
import Cabecera from "@/components/layout/Cabecera.astro";
import PiePagina from "@/components/layout/PiePagina.astro";
import { SITIO } from "@/config/sitio";

interface Props {
  /** Título de la página; se completa como «Título · Camino del Flautista». */
  titulo: string;
  /** Descripción para buscadores y vistas previas. Por defecto, la del sitio. */
  descripcion?: string;
}
const { titulo, descripcion = SITIO.descripcion } = Astro.props;
---

<!doctype html>
<html lang={SITIO.idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={descripcion} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{titulo} · {SITIO.nombre}</title>
    <!--
      Aplica el tema guardado ANTES de pintar la página, para evitar un parpadeo de color.
      Va `is:inline` (sin procesar ni diferir) precisamente para que se ejecute ya.
      La clave "tema" la escribe el componente SelectorTema.
    -->
    <script is:inline>
      try {
        const t = localStorage.getItem("tema");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 tarjeta px-4 py-2">
      Saltar al contenido
    </a>
    <Cabecera />
    <main id="contenido" class="mx-auto max-w-6xl px-4 py-8 sm:py-12">
      <slot />
    </main>
    <PiePagina />
  </body>
</html>
