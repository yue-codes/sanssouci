---
/**
 * @component CabeceraJefe
 * Portada de la página de un jefe, como la entrada de un enemigo en un juego: su
 * imagen a sangre con un resplandor rosa (el color de los jefes), el nombre en
 * grande, su barra de vida (isla `VidaJefe`) y la ficha del enemigo: tempo,
 * dificultad, ruta, llaves (isla `LlavesPuerta`) y cuándo toca enfrentarlo.
 *
 * Es estática (la imagen se optimiza al compilar): lo que depende de tu progreso
 * está en esas dos islas, que lo reciben de la arena por `estadoJefe` (`./combate`).
 */
import { CalendarDays, Crown, Swords } from "lucide-preact";
import FondoPortada from "@/components/ui/FondoPortada.astro";
import MigasDePan from "@/components/ui/MigasDePan.astro";
import ChipRuta from "@/components/canciones/ChipRuta";
import Dificultad from "@/components/canciones/Dificultad";
import LlavesPuerta from "./LlavesPuerta";
import VidaJefe from "./VidaJefe";
import type { Cancion, Jefe, Nivel, Ruta } from "@/lib/contenido";
import { nombreCortoRuta } from "@/lib/contenido";
import { imagenDeJefe } from "@/config/imagenes";
import { fechaLarga } from "@/lib/fechas";

interface Props {
  jefe: Jefe;
  nivel: Nivel;
  cancion: Cancion;
  ruta: Ruta;
  /** Día del plan en que toca enfrentarlo, si cae en los 90 días. */
  dia?: { numero: number; fecha: string };
  /** Número de día de hoy (cuenta atrás). */
  hoy: number;
}
const { jefe, nivel, cancion, ruta, dia, hoy } = Astro.props;
const j = jefe.data;
const imagen = imagenDeJefe(jefe.id);
const llaves = j.requiere.map((r) => r.id);
const faltan = dia && hoy <= dia.numero ? dia.numero - Math.max(hoy, 0) : undefined;
const Icono = j.final ? Crown : Swords;
---

<section class="relative isolate overflow-hidden border-b border-peligro/30" aria-labelledby="titulo-jefe">
  <FondoPortada imagen={imagen} velo={0.7} lateral={0.25} base={45}>
    <span class="absolute inset-0 -z-10 bg-[radial-gradient(60%_80%_at_80%_40%,color-mix(in_oklab,var(--peligro)_28%,transparent),transparent_70%)] mix-blend-screen" aria-hidden="true"></span>
  </FondoPortada>

  <div class="contenedor pt-8 pb-14 sm:pb-20">
    <MigasDePan items={[
      { texto: "Mapa", href: "/mapa" },
      { texto: `Zona ${nivel.data.orden}`, href: `/niveles/${nivel.id}` },
      { texto: j.nombre },
    ]} />

    <div class="mt-10 grid gap-10 lg:grid-cols-[1.4fr_1fr] lg:items-end lg:gap-16">
      <div data-revelar="hijos">
        <p class="flex flex-wrap items-center gap-3 font-mono text-[0.6875rem] tracking-[0.1em] text-peligro uppercase">
          <span class="inline-flex items-center gap-2"><Icono size={14} aria-hidden="true" /> {j.final ? "Jefe final" : "Jefe"} · Zona {nivel.data.orden} · {nivel.data.nombre}</span>
        </p>
        <h1 id="titulo-jefe" class="mt-4 text-6xl leading-[0.9] sm:text-8xl">{j.nombre}</h1>
        <p class="mt-4 text-lg text-texto/90">
          {cancion.data.titulo}
          <span class="text-tenue"> · {cancion.data.obra}{cancion.data.compositor && ` · ${cancion.data.compositor}`}</span>
        </p>
        <p class="mt-3 max-w-[52ch] text-tenue">{j.descripcion}</p>

        <div class="mt-8">
          <VidaJefe client:load total={j.condicionVictoria.criterios.length + 1} llaves={llaves} />
        </div>
      </div>

      <!-- Ficha del enemigo -->
      <dl class="grid grid-cols-2 gap-px overflow-hidden rounded-md border border-peligro/30 bg-peligro/20" data-revelar>
        <div class="bg-fondo/85 p-4 backdrop-blur-md">
          <dt class="font-mono text-[0.625rem] text-tenue uppercase">Tempo</dt>
          <dd class="mt-1.5 text-lg leading-tight font-semibold">{j.condicionVictoria.tempo}</dd>
        </div>
        <div class="bg-fondo/85 p-4 backdrop-blur-md">
          <dt class="font-mono text-[0.625rem] text-tenue uppercase">Dificultad</dt>
          <dd class="mt-2"><Dificultad valor={cancion.data.dificultad} /></dd>
        </div>
        <div class="bg-fondo/85 p-4 backdrop-blur-md">
          <dt class="font-mono text-[0.625rem] text-tenue uppercase">Llaves</dt>
          <dd class="mt-1.5"><LlavesPuerta client:load llaves={llaves} /></dd>
        </div>
        <div class="bg-fondo/85 p-4 backdrop-blur-md">
          <dt class="font-mono text-[0.625rem] text-tenue uppercase">Ruta</dt>
          <dd class="mt-2"><ChipRuta nombre={nombreCortoRuta(ruta)} color={ruta.data.color} /></dd>
        </div>
        <div class="col-span-2 bg-fondo/85 p-4 backdrop-blur-md">
          <dt class="font-mono text-[0.625rem] text-tenue uppercase">Cuándo</dt>
          <dd class="mt-1">
            {dia ? (
              <a href={`/dias/${dia.numero}`} class="group inline-flex items-center gap-2 hover:text-acento-claro">
                <CalendarDays size={16} class="text-peligro" aria-hidden="true" />
                <span class="font-display text-2xl">Día {dia.numero}</span>
                <span class="text-sm text-tenue">· {fechaLarga(dia.fecha)}{faltan !== undefined && ` · faltan ${faltan} días`}</span>
              </a>
            ) : (
              <span class="text-sm text-tenue">Fuera de los 90 días: se enfrenta cuando cumplas los criterios de la zona ({nivel.data.estimacion}).</span>
            )}
          </dd>
        </div>
      </dl>
    </div>
  </div>
</section>
