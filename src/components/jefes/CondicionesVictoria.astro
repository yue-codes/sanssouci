---
/**
 * @component CondicionesVictoria
 * Lista de comprobación de lo que hay que cumplir para vencer a un jefe.
 * Siempre incluye la grabación, porque grabar es parte de la victoria.
 */
import { Video } from "lucide-preact";
import type { Jefe } from "@/lib/contenido";

interface Props {
  /** Condición de victoria del jefe. */
  condicion: Jefe["data"]["condicionVictoria"];
  /** Nivel del título, para respetar la jerarquía de la página. Por defecto, h3. */
  nivelTitulo?: "h2" | "h3";
}
const { condicion, nivelTitulo = "h3" } = Astro.props;
const Titulo = nivelTitulo;
---

<div>
  <Titulo class="font-sans text-sm font-semibold">Condiciones de victoria</Titulo>
  <p class="mt-1 text-xs text-tenue">⏱ {condicion.tempo}</p>
  <ul class="mt-3 grid gap-2.5 text-sm">
    {condicion.criterios.map((c) => (
      <li class="flex gap-2.5">
        <span class="mt-1 size-4 shrink-0 rounded border-2 border-acento/70" aria-hidden="true"></span>
        <span class="leading-relaxed">{c}</span>
      </li>
    ))}
    <li class="flex gap-2.5">
      <span class="mt-1 size-4 shrink-0 rounded border-2 border-acento/70" aria-hidden="true"></span>
      <span class="flex items-center gap-1.5 leading-relaxed font-medium">
        <Video size={14} aria-hidden="true" /> Grabar el video de la victoria.
      </span>
    </li>
  </ul>
</div>
