---
/**
 * @component SemanaCalendario
 * Una semana del plan: cabecera (número, fechas, fase) y sus 7 días de lunes a
 * domingo. Los huecos sin día (final del plan) quedan vacíos para no descuadrar.
 */
import CeldaDia from "./CeldaDia.astro";
import type { Semana } from "@/lib/calendario";
import { hitosDelDia, minutosDelDia } from "@/lib/calendario";
import { fechaCorta } from "@/lib/fechas";

interface Props {
  /** Semana a mostrar (ver `semanasDelPlan`). */
  semana: Semana;
  /** Número del primer día con flauta, para marcar la llegada. */
  diaFlauta: number;
  /** Número del día de hoy en el plan. */
  hoy: number;
}
const { semana, diaFlauta, hoy } = Astro.props;
const FASE = { "sin-flauta": "Sin flauta", "con-flauta": "Con flauta", mixta: "Llega la flauta" };
const DIAS = ["Lun", "Mar", "Mié", "Jue", "Vie", "Sáb", "Dom"];
---

<section aria-labelledby={`semana-${semana.numero}`}>
  <div class="mb-3 flex flex-wrap items-baseline gap-x-3 gap-y-1">
    <h2 id={`semana-${semana.numero}`} class="text-xl font-semibold">Semana {semana.numero}</h2>
    <span class="text-sm text-tenue">{fechaCorta(semana.inicio)} – {fechaCorta(semana.fin)}</span>
    <span
      class:list={[
        "rounded-full px-2.5 py-0.5 text-xs font-semibold",
        semana.fase === "sin-flauta" ? "bg-superficie-2 text-secundario" : "bg-acento-suave text-acento",
      ]}
    >{FASE[semana.fase]}</span>
  </div>

  <!-- Nombres de los días: solo en la cuadrícula (desde sm) -->
  <div class="mb-1.5 hidden grid-cols-7 gap-2 text-center text-[11px] font-semibold uppercase tracking-wider text-tenue sm:grid" aria-hidden="true">
    {DIAS.map((d) => <span>{d}</span>)}
  </div>

  <ol class="grid gap-2 sm:grid-cols-7">
    {semana.dias.map((dia) => (
      <li class:list={["sm:min-h-32", { "hidden sm:block": !dia }]}>
        {dia && <CeldaDia dia={dia} hitos={hitosDelDia(dia, diaFlauta)} minutos={minutosDelDia(dia)} esHoy={dia.data.numero === hoy} />}
      </li>
    ))}
  </ol>
</section>
