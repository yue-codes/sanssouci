---
/**
 * @component SemanaCalendario
 * Una semana del plan como una fila del tablero: a la izquierda, su número,
 * fechas y fase; a la derecha, sus 7 días de lunes a domingo. Los huecos sin día
 * (final del plan) quedan vacíos para no descuadrar.
 *
 * Los nombres de los días (Lun… Dom) los pinta la página una sola vez, arriba.
 */
import CeldaDia from "./CeldaDia.astro";
import type { Contenido } from "@/lib/contenido";
import type { Semana } from "@/lib/calendario";
import { hitosDelDia, minutosDelDia } from "@/lib/calendario";
import { fechaCorta } from "@/lib/fechas";

interface Props {
  /** Semana a mostrar (ver `semanasDelPlan`). */
  semana: Semana;
  /** Número del primer día con flauta, para marcar la llegada. */
  diaFlauta: number;
  /** Número del día de hoy en el plan. */
  hoy: number;
  /** Contenido (para el nombre de los jefes). */
  c: Contenido;
}
const { semana, diaFlauta, hoy, c } = Astro.props;
const FASE = { "sin-flauta": "Sin flauta", "con-flauta": "Con flauta", mixta: "Llega la flauta" };
const enCurso = semana.dias.some((d) => d?.data.numero === hoy);
---

<section aria-labelledby={`semana-${semana.numero}`} class="grid gap-2 md:grid-cols-[7.5rem_1fr] md:gap-3" data-revelar>
  <div class="flex items-baseline gap-3 md:flex-col md:gap-1 md:pt-2">
    <h3 id={`semana-${semana.numero}`} class:list={["font-display text-2xl leading-none", enCurso && "text-acento-claro"]}>
      Semana {semana.numero}
    </h3>
    <span class="font-mono text-[0.625rem] text-tenue">{fechaCorta(semana.inicio)} – {fechaCorta(semana.fin)}</span>
    <span class:list={[
      "font-mono text-[0.625rem] tracking-[0.06em] uppercase",
      semana.fase === "sin-flauta" ? "text-secundario" : "text-resalte",
    ]}>{FASE[semana.fase]}</span>
  </div>

  <ol class="grid gap-2 md:grid-cols-7">
    {semana.dias.map((dia) => (
      <li class:list={["md:min-h-30", { "hidden md:block": !dia }]}>
        {dia && (
          <CeldaDia
            dia={dia}
            hitos={hitosDelDia(dia, diaFlauta)}
            minutos={minutosDelDia(dia)}
            jefe={dia.data.jefe && c.jefePorId.get(dia.data.jefe.id)!.data.nombre}
            hoy={hoy}
          />
        )}
      </li>
    ))}
  </ol>
</section>
