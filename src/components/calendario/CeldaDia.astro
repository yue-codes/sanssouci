---
/**
 * @component CeldaDia
 * Un día del calendario como casilla de un tablero: número, título, minutos (en
 * una barrita que crece con la duración) e hitos. Lleva a /dias/[n].
 * En el celular es una fila; desde `md`, una casilla de la cuadrícula semanal.
 *
 * Estados: los días ya pasados llevan una línea cian abajo (el camino recorrido);
 * hoy brilla en cian; el día de un jefe va en rosa con su nombre; la llegada de
 * la flauta, en lavanda; los descansos, atenuados y compactos.
 */
import { Moon } from "lucide-preact";
import { HITO } from "./hitos";
import type { Dia } from "@/lib/contenido";
import type { Hito } from "@/lib/calendario";
import { fechaCorta } from "@/lib/fechas";

interface Props {
  /** Día a mostrar. */
  dia: Dia;
  /** Hitos del día (ver `hitosDelDia`). */
  hitos: Hito[];
  /** Minutos de la sesión. */
  minutos: number;
  /** Nombre del jefe, si hoy hay uno. */
  jefe?: string;
  /** Número del día de hoy en el plan. */
  hoy: number;
}
const { dia, hitos, minutos, jefe, hoy } = Astro.props;
const d = dia.data;
const descanso = d.tipo === "descanso";
const esHoy = d.numero === hoy;
const pasado = d.numero < hoy;
const tono = esHoy ? "hoy" : hitos.includes("jefe") ? "jefe" : hitos.includes("flauta") ? "flauta" : descanso ? "descanso" : "normal";
---

<a
  href={`/dias/${d.numero}`}
  aria-current={esHoy ? "date" : undefined}
  data-tono={tono}
  class="group relative flex h-full gap-3 overflow-hidden rounded-md border p-3 transition duration-300 ease-suave hover:-translate-y-0.5 md:flex-col md:gap-1.5
         data-[tono=normal]:border-borde data-[tono=normal]:bg-superficie data-[tono=normal]:hover:border-acento/50
         data-[tono=descanso]:border-transparent data-[tono=descanso]:bg-superficie/40 data-[tono=descanso]:text-tenue
         data-[tono=hoy]:border-acento data-[tono=hoy]:bg-acento-suave data-[tono=hoy]:shadow-[0_0_30px_-8px_var(--acento)]
         data-[tono=jefe]:border-peligro/60 data-[tono=jefe]:bg-[color-mix(in_oklab,var(--peligro)_10%,var(--superficie))] data-[tono=jefe]:hover:border-peligro
         data-[tono=flauta]:border-resalte data-[tono=flauta]:shadow-[0_0_24px_-10px_var(--resalte)] data-[tono=flauta]:bg-[color-mix(in_oklab,var(--resalte)_10%,var(--superficie))]"
>
  <span class="flex w-16 shrink-0 flex-col md:w-auto md:flex-row md:items-baseline md:justify-between">
    <span class="font-mono text-[0.625rem] tracking-[0.06em] text-tenue uppercase md:hidden">{d.diaSemana.slice(0, 3)}</span>
    <span class="font-display text-2xl leading-none group-data-[tono=hoy]:text-acento-claro">{d.numero}</span>
    <span class="font-mono text-[0.625rem] text-tenue">{fechaCorta(d.fecha)}</span>
  </span>

  <span class="min-w-0 flex-1">
    {esHoy && <span class="block font-mono text-[0.625rem] font-semibold tracking-[0.08em] text-acento uppercase">Hoy</span>}
    {descanso ? (
      <span class="flex items-center gap-1.5 text-sm"><Moon size={13} aria-hidden="true" /> Descanso</span>
    ) : (
      <>
        {jefe && <span class="block font-mono text-[0.625rem] font-semibold tracking-[0.06em] text-peligro uppercase">Jefe</span>}
        <span class="line-clamp-2 text-sm leading-snug">{jefe ?? d.titulo}</span>
        <span class="mt-1.5 flex items-center gap-2 font-mono text-[0.625rem] text-tenue">
          <span class="h-1 rounded-full bg-current opacity-50" style={`width:${Math.round(minutos / 1.5)}%`} aria-hidden="true"></span>
          {minutos} min
        </span>
      </>
    )}
  </span>

  {hitos.length > 0 && (
    <span class="flex shrink-0 items-start gap-1 md:absolute md:right-2.5 md:bottom-2.5">
      {hitos.filter((h) => h !== "jefe" || !jefe).map((h) => {
        const { Icono, nombre, clase } = HITO[h];
        return (
          <span title={nombre} class={clase}>
            <Icono size={14} aria-hidden="true" />
            <span class="sr-only">{nombre}</span>
          </span>
        );
      })}
    </span>
  )}
  {pasado && <span class="absolute inset-x-0 bottom-0 h-0.5 bg-acento/70" aria-hidden="true"></span>}
  {pasado && <span class="sr-only">(ya pasó)</span>}
</a>
