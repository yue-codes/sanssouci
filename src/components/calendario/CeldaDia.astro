---
/**
 * @component CeldaDia
 * Un día del calendario: número, fecha, título, minutos e hitos. Lleva a /dias/[n].
 * En el celular es una fila; desde `sm`, una casilla de la cuadrícula semanal.
 * Los días de descanso se ven atenuados y compactos.
 */
import { Moon } from "lucide-preact";
import { HITO } from "./hitos";
import type { Dia } from "@/lib/contenido";
import type { Hito } from "@/lib/calendario";
import { fechaCorta } from "@/lib/fechas";

interface Props {
  /** Día a mostrar. */
  dia: Dia;
  /** Hitos del día (ver `hitosDelDia`). */
  hitos: Hito[];
  /** Minutos de la sesión. */
  minutos: number;
  /** Si es el día de hoy. */
  esHoy?: boolean;
}
const { dia, hitos, minutos, esHoy = false } = Astro.props;
const d = dia.data;
const descanso = d.tipo === "descanso";
---

<a
  href={`/dias/${d.numero}`}
  aria-current={esHoy ? "date" : undefined}
  class:list={[
    "group relative flex h-full gap-3 rounded-xl border p-3 transition hover:-translate-y-0.5 hover:border-acento/60 sm:flex-col sm:gap-1.5",
    descanso ? "border-transparent bg-superficie-2/40 text-tenue" : "border-borde bg-superficie",
    { "border-acento ring-2 ring-acento/40": esHoy },
    { "border-peligro/50": hitos.includes("jefe") && !esHoy },
  ]}
>
  <span class="flex w-16 shrink-0 flex-col sm:w-auto sm:flex-row sm:items-baseline sm:justify-between">
    <span class="text-xs font-semibold uppercase tracking-wider text-tenue sm:hidden">{d.diaSemana.slice(0, 3)}</span>
    <span class="font-display text-lg leading-none font-semibold">{fechaCorta(d.fecha)}</span>
    <span class="text-[11px] text-tenue">Día {d.numero}</span>
  </span>

  <span class="min-w-0 flex-1">
    {esHoy && <span class="eyebrow block">Hoy</span>}
    {descanso ? (
      <span class="flex items-center gap-1.5 text-sm"><Moon size={13} aria-hidden="true" /> Descanso</span>
    ) : (
      <>
        <span class="line-clamp-2 text-sm font-medium leading-snug">{d.titulo}</span>
        <span class="mt-1 block text-[11px] text-tenue">{minutos} min</span>
      </>
    )}
  </span>

  {hitos.length > 0 && (
    <span class="flex shrink-0 items-start gap-1 sm:absolute sm:right-2 sm:bottom-2">
      {hitos.map((h) => {
        const { Icono, nombre, clase } = HITO[h];
        return (
          <span title={nombre} class={clase}>
            <Icono size={15} aria-hidden="true" />
            <span class="sr-only">{nombre}</span>
          </span>
        );
      })}
    </span>
  )}
</a>
