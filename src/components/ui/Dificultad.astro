---
/** Dificultad 1–10 como 10 barritas. El color sube de plata (fácil) a oro (difícil). */
interface Props {
  valor: number;
}
const { valor } = Astro.props;
const color = valor >= 8 ? "bg-peligro" : valor >= 5 ? "bg-oro" : "bg-aurora";
---

<span class="inline-flex items-center gap-2" title={`Dificultad ${valor} de 10`}>
  <span class="flex gap-0.5" aria-hidden="true">
    {Array.from({ length: 10 }, (_, i) => (
      <span class={`h-3 w-1.5 rounded-full ${i < valor ? color : "bg-borde"}`} />
    ))}
  </span>
  <span class="text-xs font-semibold tabular-nums text-tenue"><span class="sr-only">Dificultad </span>{valor}/10</span>
</span>
