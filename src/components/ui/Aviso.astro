---
/**
 * @component Aviso
 * Nota destacada de una línea o dos, con icono. Genérico: el texto va en el slot.
 *
 * @example
 * <Aviso>El progreso es de ejemplo hasta que exista el inicio de sesión.</Aviso>
 */
import { Info } from "lucide-preact";

interface Props {
  /** Clases extra (por ejemplo, márgenes). */
  class?: string;
}
const { class: clase = "" } = Astro.props;
---

<p class:list={["flex items-start gap-2.5 rounded-xl border border-dashed border-acento/50 bg-acento-suave/40 px-4 py-3 text-sm", clase]}>
  <Info size={16} class="mt-0.5 shrink-0 text-acento" aria-hidden="true" />
  <span><slot /></span>
</p>
