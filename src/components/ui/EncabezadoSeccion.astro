---
/**
 * @component EncabezadoSeccion
 * Antetítulo + título de una sección, con una entradilla y un enlace opcionales
 * («Ver todas →»). Mantiene igual todas las secciones de las páginas.
 */
interface Props {
  /** Texto pequeño sobre el título. */
  eyebrow?: string;
  /** Título de la sección (se pinta como h2). */
  titulo: string;
  /** Id del título, para enlazarlo con `aria-labelledby` desde la sección. */
  id?: string;
  /** Entradilla opcional bajo el título. */
  descripcion?: string;
  /** Enlace opcional a la derecha. */
  enlace?: { href: string; texto: string };
  /** `grande` para las secciones principales de la portada. */
  tamano?: "normal" | "grande";
}
const { eyebrow, titulo, id, descripcion, enlace, tamano = "normal" } = Astro.props;
---

<div class="mb-8 flex flex-wrap items-end justify-between gap-x-8 gap-y-3" data-revelar>
  <div class="max-w-2xl">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2 id={id} class:list={["mt-2 leading-[1.02]", tamano === "grande" ? "text-4xl sm:text-6xl" : "text-3xl sm:text-4xl"]}>{titulo}</h2>
    {descripcion && <p class="mt-3 text-tenue">{descripcion}</p>}
  </div>
  {enlace && (
    <a href={enlace.href} class="enlace-flecha">
      {enlace.texto} <span aria-hidden="true">→</span>
    </a>
  )}
</div>
