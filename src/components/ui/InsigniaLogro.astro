---
import { BookOpen, Brain, Wind, Waves, Hand, Music, Ear, Flame, Video, Library } from "lucide-preact";
import type { Logro } from "../../lib/contenido";

interface Props {
  logro: Logro;
  obtenido?: boolean;
}
const { logro, obtenido = false } = Astro.props;
const l = logro.data;
// Un icono por categoría: si se añade una categoría al esquema, TypeScript avisará aquí.
const ICONOS: Record<typeof l.categoria, typeof Wind> = {
  lectura: BookOpen, teoria: Brain, respiracion: Wind, sonido: Waves, tecnica: Hand,
  escalas: Music, oido: Ear, habito: Flame, grabacion: Video, repertorio: Library,
};
const Icono = ICONOS[l.categoria];
---

<div data-obtenido={obtenido} class="group tarjeta flex items-start gap-3 p-4 data-[obtenido=false]:opacity-70">
  <span
    class="relative grid size-12 shrink-0 place-items-center rounded-xl border-2 border-borde text-tenue
           group-data-[obtenido=true]:border-oro group-data-[obtenido=true]:bg-gradient-to-br group-data-[obtenido=true]:from-oro group-data-[obtenido=true]:to-oro/60 group-data-[obtenido=true]:text-fondo group-data-[obtenido=true]:shadow-[0_8px_24px_-8px_var(--oro)]"
  >
    <Icono size={22} aria-hidden="true" />
  </span>
  <div class="min-w-0">
    <p class="font-semibold leading-tight">{l.nombre}</p>
    <p class="mt-1 text-xs leading-relaxed text-tenue">{l.criterio}</p>
    <p class="mt-1.5 text-[11px] font-semibold uppercase tracking-wider text-tenue group-data-[obtenido=true]:text-oro">
      {obtenido ? "Obtenido" : l.categoria}
    </p>
  </div>
</div>
