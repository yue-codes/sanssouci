---
/**
 * @component NavegacionVecinos
 * Enlaces «anterior» y «siguiente» al pie de una página de detalle
 * (zona anterior y siguiente, jefe anterior y siguiente, día anterior y siguiente…).
 */
import { ArrowLeft, ArrowRight } from "lucide-preact";

/** Un vecino: a dónde lleva y qué se muestra. */
interface Vecino {
  href: string;
  /** Texto pequeño, p. ej. «Zona 3». */
  etiqueta: string;
  /** Texto principal, p. ej. el nombre de la zona. */
  titulo: string;
}

interface Props {
  anterior?: Vecino;
  siguiente?: Vecino;
}
const { anterior, siguiente } = Astro.props;
const CLASE = "group flex items-center gap-4 rounded-md border border-borde bg-superficie p-4 transition-colors duration-300 hover:border-acento/50 hover:bg-superficie-2";
---

<nav aria-label="Anterior y siguiente" class="mt-20 grid gap-3 border-t border-borde pt-8 sm:grid-cols-2">
  {anterior ? (
    <a href={anterior.href} class={CLASE}>
      <ArrowLeft size={18} class="shrink-0 text-tenue transition-transform duration-300 group-hover:-translate-x-1 group-hover:text-acento" aria-hidden="true" />
      <span class="min-w-0">
        <span class="block font-mono text-[0.625rem] tracking-[0.06em] text-tenue uppercase">Anterior · {anterior.etiqueta}</span>
        <span class="mt-0.5 block truncate font-display text-2xl leading-tight">{anterior.titulo}</span>
      </span>
    </a>
  ) : <span />}
  {siguiente && (
    <a href={siguiente.href} class:list={[CLASE, "justify-end text-right sm:col-start-2"]}>
      <span class="min-w-0">
        <span class="block font-mono text-[0.625rem] tracking-[0.06em] text-tenue uppercase">Siguiente · {siguiente.etiqueta}</span>
        <span class="mt-0.5 block truncate font-display text-2xl leading-tight">{siguiente.titulo}</span>
      </span>
      <ArrowRight size={18} class="shrink-0 text-tenue transition-transform duration-300 group-hover:translate-x-1 group-hover:text-acento" aria-hidden="true" />
    </a>
  )}
</nav>
