---
/**
 * @component ListaVersiones
 * Versiones de una obra en YouTube: miniatura, canal, duración y para qué
 * sirve cada una (partitura, referencia…). Cada tarjeta abre el video.
 */
import { ExternalLink } from "lucide-preact";
import { USO_VERSION } from "./usos";
import type { Cancion } from "@/lib/contenido";
import { miniaturaYoutube, urlYoutube } from "@/lib/contenido";
import { duracion } from "@/lib/formato";

interface Props {
  /** Versiones a mostrar. */
  versiones: Cancion["data"]["versiones"];
}
const { versiones } = Astro.props;
---

<ul class="grid gap-4 sm:grid-cols-2">
  {versiones.map((v) => (
    <li>
      <a href={urlYoutube(v.youtubeId)} target="_blank" rel="noopener noreferrer" class="tarjeta group flex h-full gap-4 p-3 transition hover:border-acento/50">
        <span class="relative w-36 shrink-0 overflow-hidden rounded-xl bg-superficie-2">
          <img src={miniaturaYoutube(v.youtubeId)} alt="" loading="lazy" class="aspect-video size-full object-cover" />
          {v.duracionSeg && (
            <span class="absolute right-1.5 bottom-1.5 rounded bg-fondo/85 px-1.5 text-[11px] font-medium text-texto tabular-nums">{duracion(v.duracionSeg)}</span>
          )}
        </span>
        <span class="min-w-0 flex-1">
          <span class="line-clamp-2 text-sm font-semibold leading-snug group-hover:underline">{v.tituloVideo}</span>
          <span class="mt-0.5 block text-xs text-tenue">{v.canal} · {v.instrumentacion}</span>
          <span class="mt-2 flex flex-wrap gap-1">
            {v.usos.map((u) => {
              const { nombre, Icono } = USO_VERSION[u];
              return (
                <span class="inline-flex items-center gap-1 rounded-full border border-borde px-2 py-0.5 text-[11px] text-tenue">
                  <Icono size={11} aria-hidden="true" /> {nombre}
                </span>
              );
            })}
          </span>
          {v.nota && <span class="mt-2 block text-xs text-tenue">{v.nota}</span>}
        </span>
        <ExternalLink size={14} class="shrink-0 text-tenue" aria-hidden="true" />
        <span class="sr-only">(se abre en YouTube, en otra pestaña)</span>
      </a>
    </li>
  ))}
</ul>
