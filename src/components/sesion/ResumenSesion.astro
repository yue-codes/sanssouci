---
/**
 * @component ResumenSesion
 * Una sesión en pequeño: título, objetivo, una barra con el reparto de los
 * minutos (cada bloque ocupa lo que dura), los bloques con su actividad y un
 * botón a la página del día (donde está el cronómetro de la sesión).
 *
 * La barra crece al entrar en pantalla (`data-crecer`, ver src/scripts/movimiento.ts).
 */
import { CircleCheck } from "lucide-preact";
import { TIPO_BLOQUE } from "./bloques";
import type { Dia } from "@/lib/contenido";
import { minutosDelDia } from "@/lib/calendario";
import { fechaLarga } from "@/lib/fechas";
import { sumarMinutos } from "@/lib/formato";
import { HORARIO } from "@/config/sitio";

interface Props {
  /** El día de práctica a resumir. */
  dia: Dia;
  /** Antetítulo, p. ej. «Hoy toca» o «Próxima sesión». */
  etiqueta: string;
  /** Si ya está completada (solo con progreso real). Muestra una marca junto al título. */
  hecha?: boolean;
  /** Clases extra. */
  class?: string;
}
const { dia, etiqueta, hecha = false, class: clase = "" } = Astro.props;
const d = dia.data;
const total = minutosDelDia(dia);

/**
 * Color de cada bloque en la barra y en su marca de la lista. Va por posición
 * (no por tipo) para que dos bloques seguidos nunca compartan color.
 */
const COLORES = ["bg-exito", "bg-acento", "bg-texto/80", "bg-peligro", "bg-resalte", "bg-secundario"];

// Marcas de la escala bajo la barra: cada 15 min (salvo si quedan pegadas al final) y el total.
const marcas = [...Array.from({ length: Math.ceil(total / 15) }, (_, i) => i * 15).filter((m) => total - m >= 8), total];
---

<article class:list={["tarjeta flex flex-col p-6 sm:p-8", clase]}>
  <div class="flex flex-wrap items-center justify-between gap-2">
    <p class="eyebrow">{etiqueta} · {fechaLarga(d.fecha)}</p>
    {hecha && (
      <span class="inline-flex items-center gap-1 font-mono text-[0.6875rem] text-exito uppercase">
        <CircleCheck size={13} aria-hidden="true" /> Hecha
      </span>
    )}
  </div>
  <h2 class="mt-3 text-3xl leading-[1.05] sm:text-4xl">{d.titulo}</h2>
  <p class="mt-2 max-w-prose text-tenue">{d.objetivo}</p>

  <div class="mt-7" aria-hidden="true">
    <div class="flex h-2.5 gap-[3px]" data-crecer>
      {d.bloques.map((b, i) => <span class:list={["block rounded-[2px]", COLORES[i % COLORES.length]]} style={{ flex: b.minutos }} />)}
    </div>
    <div class="relative mt-1.5 h-4 font-mono text-[0.625rem] text-tenue tabular-nums">
      {marcas.map((m, i) => (
        <span
          class:list={["absolute top-0", i === 0 ? "" : i === marcas.length - 1 ? "right-0" : "-translate-x-1/2"]}
          style={i === marcas.length - 1 ? undefined : { left: `${(m / total) * 100}%` }}
        >
          {i === marcas.length - 1 ? `${m} min` : m}
        </span>
      ))}
    </div>
  </div>

  <ol class="mt-4" aria-label="Bloques de la sesión">
    {d.bloques.map((b, i) => (
      <li class="grid grid-cols-[0.625rem_1fr_auto] gap-x-4 border-t border-borde py-4 first:border-t-0">
        <span class:list={["mt-[0.45rem] size-2.5 rounded-full", COLORES[i % COLORES.length]]} aria-hidden="true" />
        <div class="min-w-0">
          <p class="font-semibold">{TIPO_BLOQUE[b.tipo].nombre}</p>
          <p class="mt-1 line-clamp-2 text-sm leading-relaxed text-tenue">{b.actividad}</p>
        </div>
        <span class="font-mono text-xs text-tenue tabular-nums">{b.minutos} min</span>
      </li>
    ))}
  </ol>

  {d.notas && <p class="mt-2 border-l-2 border-acento/60 pl-4 font-display text-lg leading-snug text-acento-claro italic">{d.notas}</p>}

  <div class="mt-auto flex flex-wrap items-center justify-between gap-4 pt-7">
    <span class="font-mono text-xs text-tenue tabular-nums">
      {HORARIO.inicio} – {sumarMinutos(HORARIO.inicio, total)} · día {d.numero}
    </span>
    <a href={`/dias/${d.numero}`} class="boton">
      Abrir la sesión <span aria-hidden="true">→</span>
    </a>
  </div>
</article>
