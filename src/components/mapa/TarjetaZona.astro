---
/**
 * @component TarjetaZona
 * Tarjeta compacta de una zona (nivel) del mapa con su estado.
 * El estilo de cada estado sale del atributo `data-estado` (variantes `data-[estado=…]:`),
 * así el marcado es uno solo y no hay que encadenar condicionales de clases.
 */
import { Check, Lock, Footprints } from "lucide-preact";
import type { Nivel } from "@/lib/contenido";
import type { EstadoZona } from "@/lib/progreso";

interface Props {
  /** Nivel (zona) a mostrar. */
  nivel: Nivel;
  /** Estado de la zona para el jugador. */
  estado: EstadoZona;
  /** Avance de 0 a 1; solo se dibuja en la zona actual. */
  progreso?: number;
}
const { nivel, estado, progreso = 0 } = Astro.props;
const n = nivel.data;
const etiqueta = { superada: "Superada", actual: "Estás aquí", bloqueada: "Bloqueada" }[estado];
---

<a
  href={`/niveles/${nivel.id}`}
  data-estado={estado}
  class="group relative flex w-64 shrink-0 snap-start flex-col rounded-2xl border p-5 transition
         data-[estado=actual]:border-acento data-[estado=actual]:bg-superficie data-[estado=actual]:shadow-[0_0_0_4px_color-mix(in_oklab,var(--acento)_18%,transparent),0_20px_50px_-20px_var(--acento)]
         data-[estado=superada]:border-exito/40 data-[estado=superada]:bg-superficie/70
         data-[estado=bloqueada]:border-borde data-[estado=bloqueada]:bg-superficie/40 hover:-translate-y-1"
>
  <div class="flex items-center justify-between">
    <span class="font-display text-5xl font-semibold leading-none text-borde group-data-[estado=actual]:text-acento group-data-[estado=superada]:text-exito/70">
      {n.orden}
    </span>
    <span
      class="grid size-9 place-items-center rounded-full border border-borde text-tenue
             group-data-[estado=actual]:border-acento group-data-[estado=actual]:bg-acento group-data-[estado=actual]:text-fondo
             group-data-[estado=superada]:border-exito group-data-[estado=superada]:bg-exito group-data-[estado=superada]:text-fondo"
    >
      {estado === "superada" ? <Check size={18} aria-hidden="true" /> : estado === "actual" ? <Footprints size={18} aria-hidden="true" /> : <Lock size={16} aria-hidden="true" />}
    </span>
  </div>
  <p class="eyebrow mt-4 group-data-[estado=bloqueada]:text-tenue">{etiqueta}</p>
  <h3 class="mt-1 text-xl font-semibold leading-tight group-data-[estado=bloqueada]:text-tenue">{n.nombre}</h3>
  <p class="mt-1 text-sm text-tenue">{n.zona}</p>
  <p class="mt-auto pt-4 text-xs text-tenue">{n.estimacion}</p>
  {estado === "actual" && (
    <div class="mt-3 h-1.5 overflow-hidden rounded-full bg-borde" role="progressbar" aria-valuemin={0} aria-valuemax={100} aria-valuenow={Math.round(progreso * 100)} aria-label="Progreso de la zona">
      <div class="h-full rounded-full bg-acento" style={`width:${Math.round(progreso * 100)}%`}></div>
    </div>
  )}
</a>
