---
/**
 * @component PuertaJefe
 * Tarjeta compacta de un jefe en el sendero: la «puerta» al final de un tramo.
 * Lleva a la página del jefe.
 */
import { Music2, Check } from "lucide-preact";
import type { JefeZona } from "@/lib/mapa";

interface Props {
  /** El jefe, su canción y si ya se venció. */
  jefe: JefeZona;
}
const { jefe: { jefe, cancion, vencido } } = Astro.props;
---

<a
  href={`/jefes/${jefe.id}`}
  class:list={[
    "inline-flex max-w-full items-center gap-3 rounded-xl border bg-superficie/70 px-4 py-2.5 text-left text-sm transition",
    vencido ? "border-acento/40 hover:border-acento" : "border-peligro/30 hover:border-peligro/70",
  ]}
>
  <span class="min-w-0">
    <span class:list={["flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wider", vencido ? "text-acento" : "text-peligro"]}>
      {vencido && <Check size={12} aria-hidden="true" />}
      {jefe.data.final ? "Jefe final" : "Jefe"}{vencido ? " · vencido" : ""}
    </span>
    <span class="block font-display text-lg font-semibold leading-tight">{jefe.data.nombre}</span>
    <span class="flex items-center gap-1.5 text-xs text-tenue">
      <Music2 size={12} aria-hidden="true" /> {cancion.data.titulo} · {jefe.data.condicionVictoria.tempo}
    </span>
  </span>
</a>
