---
/**
 * @component ParadaZona
 * Tarjeta de una zona en el sendero. Las cercanas muestran sus requisitos para
 * pasar (como chips que llevan al árbol); las lejanas, solo un resumen.
 * El marcador (círculo sobre el camino) lo pinta `Sendero` en el slot del tramo.
 */
import { Lock, ArrowRight } from "lucide-preact";
import ChipLogro from "@/components/logros/ChipLogro.astro";
import type { ParadaSendero } from "@/lib/mapa";

interface Props {
  /** La zona y su estado (ver `construirSendero`). */
  parada: ParadaSendero;
}
const { parada } = Astro.props;
const n = parada.nivel.data;
const etiqueta = { superada: "Superada", actual: "Estás aquí", bloqueada: n.zona }[parada.estado];
---

<article
  data-estado={parada.estado}
  class="group tarjeta p-5 text-left data-[estado=actual]:border-acento data-[estado=actual]:shadow-[0_0_0_4px_color-mix(in_oklab,var(--acento)_15%,transparent)]"
>
  <p class="eyebrow group-data-[estado=bloqueada]:text-tenue">Zona {n.orden} · {etiqueta}</p>
  <h2 class="mt-1 text-2xl font-semibold leading-tight">
    <a href={`/niveles/${parada.nivel.id}`} class="hover:underline">{n.nombre}</a>
  </h2>
  <p class="mt-1 text-sm leading-relaxed text-tenue">{n.resumen}</p>

  {parada.lejana ? (
    <p class="mt-3 flex items-center gap-2 text-xs text-tenue">
      <Lock size={12} aria-hidden="true" /> {parada.requisitos.length} requisitos · {n.estimacion}
    </p>
  ) : (
    <>
      {parada.requisitos.length > 0 && (
        <>
          <p class="mt-4 text-xs font-semibold text-tenue">Requisitos para pasar ({parada.hechos}/{parada.requisitos.length})</p>
          <div class="mt-2 flex flex-wrap gap-1.5">
            {parada.requisitos.map((r) => <ChipLogro logro={r.logro} estado={r.estado} />)}
          </div>
        </>
      )}
      <p class="mt-3 flex flex-wrap items-center justify-between gap-2 text-xs text-tenue">
        <span>{n.estimacion}</span>
        <a href={`/niveles/${parada.nivel.id}`} class="inline-flex items-center gap-1 font-medium text-acento hover:underline">
          Temario de la zona <ArrowRight size={12} aria-hidden="true" />
        </a>
      </p>
    </>
  )}
</article>
