---
/**
 * @component MundoMapa
 * El camino completo como el mapa del mundo de un juego, que **se sube de abajo
 * arriba**: el inicio está abajo, la cumbre arriba y en la niebla.
 *
 * En el HTML el orden es el del viaje (inicio → zona 0 → su jefe → zona 1… → cumbre),
 * que es lo que leen los lectores de pantalla; `flex-col-reverse` solo le da la
 * vuelta a la vista. La niebla espesa a medida que las zonas quedan más lejos;
 * se sale por los lados, así que la sección que lo contiene necesita `overflow-x-clip`.
 */
import { Flag, Mountain } from "lucide-preact";
import FilaCamino from "./FilaCamino.astro";
import RegionZona from "./RegionZona.astro";
import PuertaJefe from "./PuertaJefe.astro";
import type { ParadaSendero } from "@/lib/mapa";
import { fechaLarga } from "@/lib/fechas";

interface Props {
  /** Zonas en orden (ver `construirSendero`). */
  paradas: ParadaSendero[];
  /** Número de día de hoy (cuenta atrás de los jefes). */
  hoy: number;
  /** Fecha ISO del día 1 (el inicio del camino). */
  inicio: string;
}
const { paradas, hoy, inicio } = Astro.props;
const actual = paradas.find((p) => p.estado === "actual")?.nivel.data.orden ?? paradas.length - 1;
const ultima = paradas[paradas.length - 1];
const todoVencido = ultima.estado === "superada" || ultima.jefes.every((j) => j.vencido);

/** Densidad de la niebla de 0,3 (la primera zona lejana) a 1 (la cumbre). */
const lejanas = paradas.filter((p) => p.lejana).length;
const densidad = (orden: number) => 0.3 + 0.7 * ((orden - actual - 2) / Math.max(1, lejanas - 1));
---

<ol class="flex flex-col-reverse" aria-label="El camino, de la primera zona a la cumbre">
  <!-- Inicio (abajo del todo) -->
  <FilaCamino abajo="ninguno" arriba="andado" lado="derecha">
    <span slot="marcador" class="grid size-10 place-items-center rounded-full border-2 border-acento bg-fondo text-acento" aria-hidden="true">
      <Flag size={16} />
    </span>
    <div>
      <p class="font-mono text-[0.625rem] tracking-[0.08em] text-acento uppercase">Inicio del camino</p>
      <p class="mt-1 font-display text-2xl">{fechaLarga(inicio)}</p>
    </div>
  </FilaCamino>

  {paradas.map((p, i) => {
    const lado = i % 2 === 0 ? "derecha" : "izquierda";
    const contrario = lado === "derecha" ? "izquierda" : "derecha";
    return (
      <>
        <RegionZona parada={p} lado={lado} densidad={densidad(p.nivel.data.orden)} />
        {p.jefes.map((j) => (
          <PuertaJefe jefe={j} zona={p.nivel.data.orden} lado={contrario} lejano={p.lejana} densidad={densidad(p.nivel.data.orden)} hoy={hoy} />
        ))}
      </>
    );
  })}

  <!-- La cumbre (arriba del todo) -->
  <FilaCamino abajo={todoVencido ? "andado" : "niebla"} arriba="ninguno" lado="derecha" niebla={todoVencido ? undefined : 1}>
    <span slot="marcador" class="grid size-12 place-items-center rounded-full border-2 border-borde-fuerte bg-fondo text-tenue" aria-hidden="true">
      <Mountain size={20} />
    </span>
    <div class="max-w-sm">
      <p class="font-mono text-[0.625rem] tracking-[0.08em] text-tenue uppercase">Fin del mapa</p>
      <p class="mt-1 font-display text-3xl leading-tight">Más allá de la cumbre</p>
      <p class="mt-2 text-sm text-tenue">Lo que viene después lo decidirán tu maestro y tu progreso.</p>
    </div>
  </FilaCamino>
</ol>
