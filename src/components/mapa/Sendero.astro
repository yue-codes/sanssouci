---
/**
 * @component Sendero
 * El mapa completo como un camino: zona → jefe(s) → zona… El tramo recorrido
 * va en color de acento y lo que falta, punteado. Lo cercano se ve con detalle;
 * lo lejano, «en niebla».
 */
import { Check, Footprints, Swords } from "lucide-preact";
import TramoSendero, { type TipoCamino } from "./TramoSendero.astro";
import ParadaZona from "./ParadaZona.astro";
import PuertaJefe from "./PuertaJefe.astro";
import type { ParadaSendero } from "@/lib/mapa";
import type { EstadoZona } from "@/lib/progreso";

interface Props {
  /** Zonas en orden (ver `construirSendero`). */
  paradas: ParadaSendero[];
}
const { paradas } = Astro.props;

/** Cómo es el camino que sale de cada zona hacia su jefe. */
const CAMINO_ZONA: Record<EstadoZona, TipoCamino> = { superada: "andado", actual: "llegando", bloqueada: "pendiente" };

/** Estilo del marcador circular de cada zona. */
const MARCADOR: Record<EstadoZona, string> = {
  superada: "border-exito bg-exito text-fondo",
  actual: "border-acento bg-acento text-fondo",
  bloqueada: "border-borde bg-superficie text-tenue",
};
---

<ol class="relative" aria-label="Zonas del camino">
  {paradas.map((p, i) => {
    // Alterna el lado de cada zona (y de su jefe) para que el camino haga zigzag.
    const lado = i % 2 === 0 ? "izquierda" : "derecha";
    return (
      <>
        <TramoSendero camino={CAMINO_ZONA[p.estado]} lado={lado} niebla={p.lejana}>
          <span slot="marcador" class="relative grid size-12 place-items-center">
            {p.estado === "actual" && <span class="absolute inset-0 animate-latido rounded-full bg-acento" aria-hidden="true" />}
            <span class:list={["relative grid size-12 place-items-center rounded-full border-2 font-display text-lg font-semibold", MARCADOR[p.estado]]}>
              {p.estado === "superada" ? <Check size={20} aria-hidden="true" />
                : p.estado === "actual" ? <Footprints size={20} aria-hidden="true" />
                : p.nivel.data.orden}
            </span>
          </span>
          <ParadaZona parada={p} />
        </TramoSendero>

        {p.jefes.map((j, k) => (
          <TramoSendero
            camino={j.vencido ? "andado" : "pendiente"}
            lado={lado}
            niebla={p.lejana}
            separacion={k === p.jefes.length - 1 ? "amplia" : "normal"}
          >
            <span
              slot="marcador"
              class:list={[
                "mt-1 grid size-9 rotate-45 place-items-center rounded-md border-2",
                j.vencido ? "border-acento bg-acento text-fondo" : "border-peligro/70 bg-superficie text-peligro",
              ]}
            >
              <Swords size={16} class="-rotate-45" aria-hidden="true" />
            </span>
            <PuertaJefe jefe={j} />
          </TramoSendero>
        ))}
      </>
    );
  })}
</ol>
