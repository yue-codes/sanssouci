---
/**
 * @component RegionZona
 * Una zona en el mapa del mundo: un medallón sobre el camino (su número y un
 * anillo con las misiones cumplidas) y la tarjeta de la región.
 *
 * Tres maneras de verse, como en un juego con niebla de guerra:
 * - **Actual o superada:** imagen, resumen y la lista de misiones (requisitos para
 *   pasar), cada una con su estado y enlazada a su logro en el árbol.
 * - **Bloqueada pero cercana:** igual, con candados; ya se ve lo que viene.
 * - **Lejana:** solo el nombre y cuánto la separa; la imagen, borrosa.
 *
 * La fila (camino y niebla) la pone `FilaCamino`; el anillo se dibuja al entrar
 * en pantalla (`data-trazar`).
 */
import { Picture } from "astro:assets";
import { Check, Lock } from "lucide-preact";
import FilaCamino, { type TipoTramo } from "./FilaCamino.astro";
import ListaMisiones from "@/components/logros/ListaMisiones.astro";
import type { ParadaSendero } from "@/lib/mapa";
import { IMAGEN_ZONA, IMAGENES } from "@/config/imagenes";

interface Props {
  /** La zona y su estado (ver `construirSendero`). */
  parada: ParadaSendero;
  /** Lado de la tarjeta desde `md`. */
  lado: "izquierda" | "derecha";
  /** Densidad de la niebla si es lejana (0 a 1): más espesa cuanto más lejos. */
  densidad?: number;
}
const { parada: p, lado, densidad = 0.5 } = Astro.props;
const n = p.nivel.data;
const imagen = IMAGEN_ZONA[p.nivel.id] ?? IMAGENES.animeCian;
const total = p.requisitos.length;
const avance = total ? Math.round((p.hechos / total) * 100) : 0;
const actual = p.estado === "actual";
const tramoPendiente: TipoTramo = p.lejana ? "niebla" : "pendiente";

const SELLO = { actual: "Estás aquí", superada: "Superada", bloqueada: "Bloqueada" }[p.estado];
---

<FilaCamino
  abajo={p.estado === "bloqueada" ? tramoPendiente : "andado"}
  arriba={p.estado === "superada" ? "andado" : tramoPendiente}
  lado={lado}
  niebla={p.lejana ? densidad : undefined}
  id={actual ? "tu-posicion" : undefined}
>
  <!-- Medallón: número de la zona y anillo de misiones cumplidas -->
  <span slot="marcador" class="relative grid size-16 place-items-center md:size-20" aria-hidden="true">
    {actual && (
      <>
        <span class="absolute inset-0 animate-latido rounded-full bg-acento/50"></span>
        <span class="absolute -top-7 left-1/2 -translate-x-1/2 animate-flotar rounded-[2px] bg-acento px-1.5 py-0.5 font-mono text-[0.625rem] font-semibold text-fondo">
          TÚ
        </span>
      </>
    )}
    <svg viewBox="0 0 100 100" class="absolute inset-0 size-full -rotate-90">
      <circle cx="50" cy="50" r="45" stroke-width="5"
        class:list={["stroke-borde", actual ? "fill-acento-suave" : p.estado === "superada" ? "fill-superficie-2" : "fill-fondo"]} />
      {avance > 0 && (
        <circle cx="50" cy="50" r="45" stroke-width="5" pathLength="100" stroke-dasharray="100" stroke-dashoffset={100 - avance}
          stroke-linecap="round" class="fill-none stroke-exito" data-trazar />
      )}
    </svg>
    <span
      class:list={[
        "relative font-display text-3xl leading-none md:text-4xl",
        actual ? "text-acento-claro" : p.estado === "superada" ? "text-exito" : "text-tenue",
      ]}
    >
      {p.estado === "superada" ? <Check size={26} strokeWidth={2.5} /> : n.orden}
    </span>
  </span>

  {p.lejana ? (
    <article class="relative overflow-hidden rounded-md border border-borde/60" data-revelar>
      <Picture src={imagen.mini} alt="" widths={[320]} sizes="20rem" formats={["avif"]} fallbackFormat="webp" loading="lazy"
        class="absolute inset-0 size-full scale-110 object-cover opacity-30 blur-md grayscale" style={{ objectPosition: imagen.enfoque }} />
      <div class="relative p-5">
        <p class="font-mono text-[0.625rem] tracking-[0.08em] text-tenue uppercase">Zona {n.orden} · en la niebla</p>
        <h3 class="mt-1 text-3xl leading-tight text-texto/80">
          <a href={`/niveles/${p.nivel.id}`} class="hover:text-texto">{n.nombre}</a>
        </h3>
        <p class="mt-2 flex flex-wrap gap-x-4 font-mono text-[0.6875rem] text-tenue">
          {total > 0 && <span class="inline-flex items-center gap-1.5"><Lock size={11} aria-hidden="true" /> {total} misiones</span>}
          <span>{n.estimacion}</span>
        </p>
      </div>
    </article>
  ) : (
    <article
      data-estado={p.estado}
      class="group overflow-hidden rounded-md border bg-superficie transition-colors duration-500
             data-[estado=actual]:border-acento/70 data-[estado=actual]:shadow-[0_0_0_1px_var(--acento),0_24px_70px_-30px_var(--acento)]
             data-[estado=superada]:border-exito/40 data-[estado=bloqueada]:border-borde"
      data-revelar
    >
      <div class="relative aspect-[16/7] overflow-hidden">
        <Picture src={imagen.src} alt="" widths={[480, 720, 1000]} sizes="(min-width: 768px) 36rem, 100vw" formats={["avif"]} fallbackFormat="webp" loading="lazy"
          class:list={["size-full object-cover transition-transform duration-[1.4s] ease-suave group-hover:scale-105", p.estado === "bloqueada" && "grayscale-[0.6]"]}
          style={{ objectPosition: imagen.enfoque }} />
        <span class="velo group-hover:opacity-0" aria-hidden="true"></span>
        <span class="absolute inset-0 bg-linear-to-t from-superficie via-superficie/30 to-transparent" aria-hidden="true"></span>
        <span
          class="absolute top-3 left-3 inline-flex items-center gap-1.5 rounded-[2px] px-2 py-1 font-mono text-[0.625rem] font-semibold uppercase
                 group-data-[estado=actual]:bg-acento group-data-[estado=actual]:text-fondo
                 group-data-[estado=superada]:bg-exito group-data-[estado=superada]:text-fondo
                 group-data-[estado=bloqueada]:bg-fondo/80 group-data-[estado=bloqueada]:text-tenue"
        >
          {p.estado === "bloqueada" && <Lock size={10} aria-hidden="true" />}
          {p.estado === "superada" && <Check size={10} aria-hidden="true" />}
          {SELLO}
        </span>
        <div class="absolute inset-x-5 bottom-3">
          <p class="font-mono text-[0.625rem] tracking-[0.08em] text-texto/80 uppercase">Zona {n.orden} · {n.zona}</p>
          <h3 class="mt-0.5 text-3xl leading-[1.05] sm:text-4xl">
            <a href={`/niveles/${p.nivel.id}`} class="hover:text-acento-claro">{n.nombre}</a>
          </h3>
        </div>
      </div>

      <div class="p-5 sm:p-6">
        <p class="text-sm leading-relaxed text-tenue">{n.resumen}</p>

        {total > 0 && (
          p.estado === "superada" ? (
            <p class="mt-4 inline-flex items-center gap-2 font-mono text-[0.6875rem] text-exito uppercase">
              <Check size={13} aria-hidden="true" /> {total} de {total} misiones cumplidas
            </p>
          ) : (
            <div class="mt-5">
              <div class="flex items-baseline justify-between font-mono text-[0.625rem] tracking-[0.06em] text-tenue uppercase">
                <span>Misiones para pasar</span>
                <span class="tabular-nums">{p.hechos} / {total}</span>
              </div>
              <ListaMisiones misiones={p.requisitos} class="mt-3" />
            </div>
          )
        )}

        <p class="mt-5 flex flex-wrap items-center justify-between gap-3 border-t border-borde pt-4">
          <span class="font-mono text-[0.6875rem] text-tenue">{n.estimacion}</span>
          <a href={`/niveles/${p.nivel.id}`} class="enlace-flecha">Temario de la zona <span aria-hidden="true">→</span></a>
        </p>
      </div>
    </article>
  )}
</FilaCamino>
