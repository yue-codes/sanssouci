---
/**
 * @component TarjetaEntrar
 * La tarjeta de /entrar, como la pantalla de «continuar partida» de un juego.
 * Sus caras:
 * - formulario en tres modos: entrar (correo + contraseña), crear cuenta y
 *   recuperar la contraseña (solo correo);
 * - «revisa tu correo» (se mandó el enlace de activar la cuenta o de recuperar);
 * - «ya estás dentro» (hay sesión).
 * Solo pinta: qué cara toca lo decide la página, que es la que habla con Supabase.
 *
 * El formulario es HTML normal (`method="post"`): funciona aunque falle una isla.
 * La única isla es `CampoContrasena` (el botón de mostrarla), y sin JavaScript
 * sigue siendo un campo normal.
 */
import { KeyRound, LogIn, Mail, MailCheck, Play, TriangleAlert, UserPlus } from "lucide-preact";
import CampoContrasena from "./CampoContrasena";
import type { EstadoEntrar } from "./estado-entrar";
import { CONTRASENA_MIN, urlEntrar, type ModoEntrar } from "@/lib/cuenta";

interface Props {
  /** Qué pasó con el formulario en esta visita. */
  estado: EstadoEntrar;
  /** La sesión, si ya hay una (muestra «ya estás dentro»). Basta con su correo. */
  sesion?: { email?: string | null };
  /** A dónde volver tras entrar (ruta interna ya validada). */
  siguiente: string;
}
const { estado, sesion, siguiente } = Astro.props;
const ETIQUETA = "font-mono text-[0.625rem] tracking-[0.08em] text-tenue uppercase";

/** Lo que cambia entre las tres caras del formulario. */
const CARAS: Record<ModoEntrar, { antetitulo: string; titulo: string; intro: string; boton: string; Icono: typeof LogIn }> = {
  entrar: { antetitulo: "Tu cuenta", titulo: "Continúa tu partida", intro: "Entra con tu correo y tu contraseña.", boton: "Entrar", Icono: LogIn },
  registro: { antetitulo: "Cuenta nueva", titulo: "Empieza tu partida", intro: "Crea tu cuenta. Te mandaremos un correo para activarla.", boton: "Crear cuenta", Icono: UserPlus },
  recuperar: { antetitulo: "¿Olvidaste tu contraseña?", titulo: "Recupera tu partida", intro: "Escribe tu correo y te mandamos un enlace para poner una contraseña nueva.", boton: "Enviarme el enlace", Icono: Mail },
};

/** Enlace de abajo para cambiar de cara. */
const OTRA_CARA: Record<ModoEntrar, { pregunta: string; texto: string; modo: ModoEntrar }> = {
  entrar: { pregunta: "¿Primera vez?", texto: "Crea tu cuenta", modo: "registro" },
  registro: { pregunta: "¿Ya tienes cuenta?", texto: "Entra", modo: "entrar" },
  recuperar: { pregunta: "¿Te acordaste?", texto: "Volver a entrar", modo: "entrar" },
};

const modo = estado.tipo === "formulario" ? estado.modo : "entrar";
const cara = CARAS[modo];
const otra = OTRA_CARA[modo];
const error = estado.tipo === "formulario" ? estado.error : undefined;
// Los ids que describen cada campo: la ayuda (si la hay) y el error (si lo hay).
const describe = (...ids: (string | false | undefined)[]) => ids.filter(Boolean).join(" ") || undefined;
---

<div class="relative overflow-hidden rounded-md border border-borde-fuerte bg-fondo/85 p-6 shadow-2xl shadow-black/40 backdrop-blur-md sm:p-8">
  <!-- Línea de luz arriba, como el borde de una ventana de juego -->
  <span class="absolute inset-x-0 top-0 h-px bg-linear-to-r from-transparent via-acento to-transparent" aria-hidden="true"></span>

  {sesion ? (
    <div class="text-center">
      <span class="mx-auto grid size-14 place-items-center rounded-full border-2 border-exito text-exito" aria-hidden="true"><Play size={22} /></span>
      <p class:list={[ETIQUETA, "mt-5"]}>Partida en curso</p>
      <h2 class="mt-1 text-4xl">Ya estás dentro</h2>
      {sesion.email && <p class="mt-2 text-sm text-tenue">Has entrado como <strong class="font-medium text-texto">{sesion.email}</strong>.</p>}
      <div class="mt-7 grid gap-3">
        <a href={siguiente} class="boton justify-center">Continuar <span aria-hidden="true">→</span></a>
        <form method="post" action="/auth/salir">
          <button type="submit" class="boton-borde w-full justify-center">Cerrar sesión</button>
        </form>
      </div>
    </div>
  ) : estado.tipo === "enviado" ? (
    <div class="text-center" role="status">
      <span class="mx-auto grid size-14 place-items-center rounded-full border-2 border-exito text-exito" aria-hidden="true"><MailCheck size={22} /></span>
      <p class:list={[ETIQUETA, "mt-5"]}>{estado.motivo === "registro" ? "Activa tu cuenta" : "Enlace enviado"}</p>
      <h2 class="mt-1 text-4xl">Revisa tu correo</h2>
      {estado.motivo === "registro" ? (
        <p class="mt-3 text-sm leading-relaxed text-tenue">
          Mandamos un enlace a <strong class="font-medium text-texto">{estado.email}</strong> para activar tu cuenta.
          Ábrelo <strong class="font-medium text-texto">en este mismo navegador</strong>. Si ya tenías cuenta con ese correo, no llegará nada: entra con tu contraseña.
        </p>
      ) : (
        // No decimos si el correo tiene cuenta: así nadie puede averiguarlo desde aquí.
        <p class="mt-3 text-sm leading-relaxed text-tenue">
          Si hay una cuenta con <strong class="font-medium text-texto">{estado.email}</strong>, te llegó un enlace para poner una contraseña nueva.
          Ábrelo <strong class="font-medium text-texto">en este mismo navegador</strong>.
        </p>
      )}
      <p class="mt-4 text-xs text-tenue">¿No llega? Mira en spam o promociones; puede tardar un minuto.</p>
      <a href={urlEntrar("entrar", siguiente)} class="enlace-flecha mt-6">Volver a entrar</a>
    </div>
  ) : (
    <form method="post" action={urlEntrar(modo, siguiente)} class="grid gap-6">
      <div>
        <p class={ETIQUETA}>{cara.antetitulo}</p>
        <h2 class="mt-1 text-4xl">{cara.titulo}</h2>
        <p class="mt-2 text-sm leading-relaxed text-tenue">{cara.intro}</p>
      </div>

      {error && (
        <p id="error-entrar" role="alert" class="flex items-start gap-2.5 rounded-[3px] border border-peligro/40 bg-peligro/10 px-4 py-3 text-sm">
          <TriangleAlert size={16} class="mt-0.5 shrink-0 text-peligro" aria-hidden="true" />
          <span>{error}</span>
        </p>
      )}

      <div>
        <label for="email" class:list={[ETIQUETA, "mb-2 block"]}>Correo</label>
        <div class="relative">
          <Mail size={16} class="pointer-events-none absolute top-1/2 left-3 -translate-y-1/2 text-tenue" aria-hidden="true" />
          <input
            id="email"
            name="email"
            type="email"
            required
            autocomplete="email"
            inputmode="email"
            maxlength={254}
            value={estado.email}
            placeholder="nombre@ejemplo.com"
            aria-invalid={error ? "true" : undefined}
            aria-describedby={describe(error && "error-entrar")}
            class="w-full rounded-[3px] border border-borde-fuerte bg-superficie py-3 pr-3 pl-9 text-sm transition-colors focus:border-acento aria-invalid:border-peligro/60"
          />
        </div>
      </div>

      {modo !== "recuperar" && (
        <div>
          <div class="mb-2 flex items-baseline justify-between gap-3">
            <label for="contrasena" class={ETIQUETA}>Contraseña</label>
            {modo === "entrar" && (
              <a href={urlEntrar("recuperar", siguiente)} class="inline-flex items-center gap-1 text-xs text-acento hover:text-acento-claro">
                <KeyRound size={12} aria-hidden="true" /> ¿La olvidaste?
              </a>
            )}
          </div>
          <CampoContrasena
            client:load
            id="contrasena"
            autocomplete={modo === "registro" ? "new-password" : "current-password"}
            minLength={modo === "registro" ? CONTRASENA_MIN : undefined}
            describedby={describe(modo === "registro" && "contrasena-ayuda", error && "error-entrar")}
            invalido={!!error}
          />
          {modo === "registro" && (
            <p id="contrasena-ayuda" class="mt-1.5 text-xs text-tenue">
              Mínimo {CONTRASENA_MIN} caracteres. Una frase de varias palabras es fácil de recordar y difícil de adivinar.
            </p>
          )}
        </div>
      )}

      <button type="submit" class="boton justify-center">
        <cara.Icono size={16} aria-hidden="true" /> {cara.boton}
      </button>

      <p class="text-center text-sm text-tenue">
        {otra.pregunta} <a href={urlEntrar(otra.modo, siguiente)} class="font-semibold text-acento hover:text-acento-claro">{otra.texto}</a>
      </p>
    </form>
  )}
</div>
