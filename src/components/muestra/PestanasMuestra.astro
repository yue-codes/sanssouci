---
/**
 * @component PestanasMuestra
 * Navegación entre las páginas de muestra de diseño.
 * Temporal: se borra junto con las muestras al cerrar la fase 3.
 */
const pestanas = [
  { href: "/muestra", texto: "Original" },
  { href: "/muestra/sendero", texto: "A · Sendero" },
  { href: "/muestra/arbol", texto: "C · Árbol de talentos" },
];
const actual = Astro.url.pathname.replace(/\/$/, "");
---

<div class="mb-8 grid gap-2 rounded-xl border border-dashed border-acento/50 bg-acento-suave/40 p-2 text-sm">
  <nav aria-label="Muestras de diseño" class="flex flex-wrap items-center gap-2">
    <span class="px-2 font-semibold">Muestras:</span>
    {pestanas.map((p) => (
      <a
        href={p.href}
        aria-current={actual === p.href ? "page" : undefined}
        class="rounded-lg px-3 py-1.5 text-tenue hover:bg-superficie hover:text-texto aria-[current=page]:bg-superficie aria-[current=page]:font-semibold aria-[current=page]:text-texto"
      >{p.texto}</a>
    ))}
    <span class="px-2 text-xs text-tenue">Contenido real · progreso de ejemplo</span>
  </nav>
</div>
