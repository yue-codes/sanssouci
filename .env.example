# Plantilla de variables de entorno. Cópiala a `.env` (que NO se sube a git) y rellena los valores:
#   cp .env.example .env
# Dónde encontrarlos: panel de Supabase → tu proyecto → Project Settings → API Keys / Data API.

# URL del proyecto, p. ej. https://abcdefghijkl.supabase.co
PUBLIC_SUPABASE_URL=

# Clave «publishable» (empieza por sb_publishable_…). Es pública a propósito:
# puede viajar al navegador porque la seguridad la ponen las reglas RLS de la base de datos.
# La clave «secret» NO va aquí ni en ningún archivo del proyecto.
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
