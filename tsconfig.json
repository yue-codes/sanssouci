{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    // Alias de imports: "@/lib/contenido" en lugar de "../../lib/contenido".
    // Astro (Vite) lee este mismo campo, así que no hace falta configurarlo en otro sitio.
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
